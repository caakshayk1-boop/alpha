{
  "name": "apexpro",
  "main": "apps/apexpro/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./apps/apexpro/public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
