  },
  "dependencies": {
    "gsap": "^3.12.5",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "axe-core": "^4.14.0",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.2",
    "pixelmatch": "6.0.0",
