---
// The hero/equity card. Data rides in a JSON block (not executed); charts.ts draws it. Persists across navigation via a view-transition name.
import { heroSeries, dmy, recordStarted, lastDay } from '../lib/view.ts'; import { ledger } from '../lib/data.ts';
const { screen = 'all', title = 'Paper record, all screens', vt = true } = Astro.props; const L = ledger(); const pts = heroSeries(L, screen); const started = recordStarted(L);
const closed = L.aggregates.find((a) => a.screen_id === screen)?.n_closed ?? 0; const last = lastDay(L, screen);
---
<div class={`card ${vt ? 'vt-equity' : ''}`} data-equity>
  <div class="card-head"><h2 class="label" data-u="h0">{title}</h2><span class="stamp">{started ? `as of ${dmy(L.as_of)}` : 'record not started'} · n = {closed} closed</span></div>
  {pts.length >= 2 ? (<><div class="chart-frame"><div class="chart" data-chart="equity" role="img" aria-label={`Return on the paper account, benchmark, and drawdown from ${dmy(pts[0].date)} to ${dmy(pts.at(-1)!.date)}`}></div></div>
    <script type="application/json" data-series set:html={JSON.stringify(pts)}></script>
    <div class="legend small"><span><i></i>Paper return on the ₹1 crore account (%)</span><span><i class="bm"></i>Nifty 500, price index only</span><span><i class="dd"></i>Drawdown from peak (lower pane, percentage points)</span></div>
    <details class="table-alt"><summary>View as table</summary><table class="cards"><thead><tr><th>Date</th><th class="num">Return %</th><th class="num">Benchmark %</th><th class="num">Drawdown pts</th></tr></thead><tbody>{pts.map((p) => <tr><td data-label="Date">{dmy(p.date)}</td><td class="num" data-label="Return %">{p.ret ?? '—'}</td><td class="num" data-label="Benchmark %">{p.bench ?? '—'}</td><td class="num" data-label="Drawdown pts">{p.dd}</td></tr>)}</tbody></table></details></>)
  : (<div class="chart-empty"><div><p class="quote-in">{started ? `Day ${pts.length} of the record.` : 'The record has not started.'}</p><p class="small muted" data-u="mauto">{started ? 'A curve needs at least two days. Open positions are marked to market each night; nothing is filled in between.' : 'The first nightly ledger run writes the first day. Until then there is nothing to plot, and nothing is shown in its place.'}</p></div></div>)}
  <p class="sim" data-u="mt3b">Simulated — not real returns. n = {closed} closed trades{closed < 30 ? ': too few to conclude anything.' : '.'} Dividends are excluded from both lines.</p>
</div>
