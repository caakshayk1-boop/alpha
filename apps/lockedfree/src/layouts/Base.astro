---
import '../styles/global.css'; import '../styles/home.css'; import SiteHeader from '../components/SiteHeader.astro'; import { DEMO } from '../lib/data.ts'; import { ledger } from '../lib/data.ts'; import { dmy } from '../lib/view.ts';
const { title, description = 'A rules-based, paper-only investing site. Published screens, a disciplined paper terminal, a written plan, and a public record that keeps every loss.', reading = false, path = Astro.url.pathname, og = '/og/default.png', charts = false, flip = false } = Astro.props;
import f4 from '@fontsource/fira-sans/files/fira-sans-latin-400-normal.woff2?url'; import f7 from '@fontsource/fira-sans/files/fira-sans-latin-700-normal.woff2?url';
const L = ledger(); const full = title === 'Rulebook' ? title : `${title} · Rulebook`; const canonical = new URL(path, Astro.site).href;
---
<!doctype html><html lang="en-IN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{full}</title><meta name="description" content={description}>
<link rel="canonical" href={canonical}><meta name="theme-color" content="#08090A"><meta name="color-scheme" content="dark">
<meta property="og:title" content={full}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:url" content={canonical}><meta property="og:image" content={new URL(og, Astro.site).href}><meta name="twitter:card" content="summary_large_image">
{[f4, f7].map((u) => <link rel="preload" as="font" type="font/woff2" href={u} crossorigin="anonymous" />)}<script type="speculationrules" is:inline set:html={JSON.stringify({ prerender: [{ where: { and: [{ href_matches: "/*" }, { not: { href_matches: ["/api/*", "/data/*", "/*.css", "/stock/*"] } }] }, eagerness: "moderate" }] })}></script><link rel="stylesheet" href="/vt.css"><link rel="icon" href="/icon.svg" type="image/svg+xml"><meta name="robots" content={DEMO || path === "/style/" ? "noindex" : "index,follow"}>
</head><body>
{DEMO && <div class="demo-banner">DEMO DATA — synthetic, for layout checks only. Never deployed.</div>}
<a class="skip" href="#main">Skip to content</a><div class="progress" aria-hidden="true"></div>
<SiteHeader path={path} />
<main id="main"><slot /></main>
<footer class="foot"><div class="wrap cols"><div class="disclaimer small"><p><strong>Educational and paper-only.</strong> Rulebook does not give investment advice, is not a broker, and does not sell tips. Nothing here is a recommendation to buy or sell anything. Every figure is simulated — not real returns.</p><p class="stamp">Charts: <a href="https://www.tradingview.com/" rel="noopener">TradingView Lightweight Charts™</a> and uPlot.</p><p class="stamp">Ledger as of {dmy(L.as_of)} · built {L.built_on ? dmy(L.built_on.slice(0, 10)) : 'not yet'}</p></div>
<div class="small"><div class="label">Rooms</div><p><a href="/terminal/">Terminal</a><br><a href="/screener/">Screener</a><br><a href="/screens/">Screens</a><br><a href="/gate/">The Gate</a><br><a href="/plan/">The Plan</a><br><a href="/ledger/">The Ledger</a></p></div>
<div class="small"><div class="label">Read</div><p><a href="/methodology/">Methodology</a><br><a href="/about/">About</a><br><a href="/ledger/voids/">Voided picks</a></p></div></div></footer>
{charts && <script src="../scripts/charts.ts"></script>}{flip && <script src="../scripts/flip.ts"></script>}<script src="../scripts/halo.ts"></script><script src="../scripts/site.ts"></script>
</body></html>
