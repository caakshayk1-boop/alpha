---
import '../styles/global.css'; import '../styles/terminal.css'; import Icon from '../components/Icon.astro'; import { loadFeed, feedAvailable } from '../lib/feed.ts'; import { dmy } from '../lib/view.ts'; import { DEMO } from '../lib/data.ts';
import fr from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url'; import it from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'; import m5 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
const { title, description = 'Rulebook terminal: market dashboard, screener, snapshot, daily brief, paper P&L and a one-page profile of every tracked stock. Educational; not advice.', path = Astro.url.pathname, charts = false, live = true } = Astro.props;
const F = feedAvailable() ? loadFeed() : null; const full = `${title} · Rulebook Terminal`; const canonical = new URL(path, Astro.site).href;
const nav = [['/terminal/', 'Terminal', 'dash'], ['/screener/', 'Screener', 'table'], ['/snapshot/', 'Snapshot', 'gauge'], ['/brief/', 'Daily brief', 'news'], ['/pnl/', 'Live P&L', 'wallet']];
---
<!doctype html><html lang="en-IN" data-surface="terminal"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{full}</title><meta name="description" content={description}>
<link rel="canonical" href={canonical}><meta name="theme-color" content="#0B0C0E"><meta name="color-scheme" content="dark"><meta property="og:title" content={full}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:url" content={canonical}><meta property="og:image" content={new URL('/og/default.png', Astro.site).href}>
{[fr, it, m5].map((u) => <link rel="preload" as="font" type="font/woff2" href={u} crossorigin="anonymous" />)}<link rel="stylesheet" href="/vt.css"><link rel="stylesheet" href="/vt-stocks.css"><script type="speculationrules" is:inline set:html={JSON.stringify({ prerender: [{ where: { and: [{ href_matches: "/*" }, { not: { href_matches: ["/api/*", "/data/*", "/*.css", "/pnl/"] } }] }, eagerness: "moderate" }] })}></script><link rel="icon" href="/icon.svg" type="image/svg+xml"><meta name="robots" content={DEMO ? 'noindex' : 'index,follow'}></head>
<body><a class="skip" href="#main">Skip to content</a>
<div class="t-shell"><nav class="t-rail" aria-label="Terminal"><a class="brandmark" href="/" data-tip="Rulebook home" aria-label="Rulebook home"><Icon name="book" size={22} /></a>{nav.map(([h, t, i]) => <a href={h} data-tip={t} aria-label={t} aria-current={path.startsWith(h) ? 'page' : undefined}><Icon name={i} size={20} /></a>)}<span class="spacer"></span><a href="/gate/" data-tip="The Gate" aria-label="The Gate"><Icon name="gate" size={20} /></a><a href="/ledger/" data-tip="The Ledger" aria-label="The Ledger"><Icon name="ledger" size={20} /></a></nav>
<div class="t-main"><header class="t-top"><span class="t-status" data-market data-state="closed"><i></i><span data-market-text>Market</span></span><span class="sep"></span><span data-clock class="hide-s">IST --:--:--</span><span class="sep hide-s"></span><span class="hide-s" title="Prices in the daily feed are last-close prices">Daily data as of {F ? dmy(F.asOf) : 'not loaded'}</span><span class="grow"></span><button class="t-cmd" type="button" data-cmdk-open aria-label="Search stocks and commands"><Icon name="search" size={14} /><span class="hide-s">Search 999 stocks</span><span class="kbd">⌘K</span></button></header>
<main id="main" class="t-body"><slot /></main></div></div>
<div class="cmdk" data-cmdk role="dialog" aria-modal="true" aria-label="Search"><div class="box"><input type="text" data-cmdk-input placeholder="Type a symbol, a company, or a command…" autocomplete="off" aria-label="Search"><ul data-cmdk-list role="listbox"></ul></div></div>
<script src="../scripts/terminal.ts"></script>{live && <script src="../scripts/live.ts"></script>}{charts && <script src="../scripts/charts.ts"></script>}</body></html>
