---
import Terminal from '../../layouts/Terminal.astro'; import { loadFeed, num, pct, spct, f0 } from '../../lib/feed.ts'; import { sectors } from '../../lib/stats.ts'; import { brief } from '../../lib/brief.ts'; import { facts } from '../../lib/insight.ts'; import { cohorts } from '../../lib/feed.ts'; import { dmy } from '../../lib/view.ts';
const F = loadFeed(); const b = F.meta.breadth; const sec = sectors(F.rows); const B = brief(F); const co = cohorts(); const cov = F.meta.coverage;
const top = [...F.rows].filter((r) => num(r, 'comp') != null && r.liquid).sort((a, c) => c.comp - a.comp || a.sym.localeCompare(c.sym)).slice(0, 8);
const idx = [['NIFTY', 'Nifty 50'], ['BANKNIFTY', 'Bank Nifty'], ['SENSEX', 'Sensex'], ['NIFTYIT', 'Nifty IT'], ['NIFTYPHARMA', 'Nifty Pharma'], ['INDIAVIX', 'India VIX']];
const tone = (v: number | null) => (v == null ? '' : v >= 2 ? 'up2' : v > 0 ? 'up1' : v <= -2 ? 'dn2' : v < 0 ? 'dn1' : '');
---
<Terminal title="Terminal" description="Market dashboard: breadth, sectors, the daily brief, delayed quotes, your watchlist and paper P&L. Educational; not advice.">
<div class="t-title"><h1>Terminal</h1><span class="stamp">daily data as of {dmy(F.asOf)} · built {dmy(F.builtOn)} · <span data-q-age>waiting for first quote…</span></span></div>
<div class="tape" aria-label="Index quotes, delayed">{idx.map(([k, n]) => <div class="q" data-q={k}><span class="s">{n}</span><span class="p" data-q-px>—</span><span class="c" data-q-chg>—</span></div>)}</div>
<div class="panes">
<section class="pane span-4"><div class="pane-h"><span><span class="idx">01</span>Market snapshot</span><a href="/snapshot/">open</a></div><div class="pane-b"><div class="hero-n"><div><div class="label">Advancing</div><div class="big-n up" data-count={b.advancing}>{b.advancing}</div></div><div><div class="label">Declining</div><div class="big-n down" data-count={b.declining}>{b.declining}</div></div></div>
<div class="split mt4" role="img" aria-label={`${b.advancing} advancing, ${b.declining} declining`}><b class="a" data-grow={(b.advancing / (b.advancing + b.declining)) * 100}></b><b class="d" data-grow={(b.declining / (b.advancing + b.declining)) * 100}></b></div>
<dl class="kv mt4"><dt>Above 20-day</dt><dd>{pct(b.above20, 0)}</dd><dt>Above 50-day</dt><dd>{pct(b.above50, 0)}</dd><dt>Above 200-day</dt><dd>{pct(b.above200, 0)}</dd><dt>Median 1-month</dt><dd>{spct(b.median_1m)}</dd><dt>Nifty, 1 month · 1 year</dt><dd>{spct(b.nifty_1m)} · {spct(b.nifty_1y)}</dd></dl></div></section>
<section class="pane span-8"><div class="pane-h"><span><span class="idx">02</span>Sectors, 1-month median return</span><a href="/snapshot/">open</a></div><div class="pane-b"><div class="heat">{sec.map((s) => <a href={`/screener/?sector=${encodeURIComponent(s.sector)}`} data-t={tone(s.r1m)} title={`${s.n} stocks · opens the screener for this sector`}><span class="n">{s.sector}</span><span class="v">{spct(s.r1m)}</span><span class="src">{s.n} stocks</span></a>)}</div></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">03</span>Daily brief</span><a href="/brief/">read</a></div><div class="pane-b prose-t"><p class="lead">{B.headline}</p>{B.paragraphs.slice(0, 2).map((p) => <p class="small">{p}</p>)}<p class="stamp">as of {dmy(B.asOf)} · written by rule from the feed</p></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">04</span>Highest composite scores</span><a href="/screener/?sort=comp">open</a></div><div class="pane-b flush"><table class="t-table"><thead><tr><th>Stock</th><th class="num">Score</th><th>Stands out on</th></tr></thead><tbody>{top.map((r) => { const fl = facts(r, co); const f = fl.find((x) => x.good === true) ?? fl[0]; return <tr><td><a href={`/stock/${r.sym}/`} data-vt={`stock-${r.sym}`}>{r.sym}</a></td><td class="num">{f0(r.comp)}</td><td class="src">{f ? f.label : 'No single standout'}</td></tr>; })}</tbody></table></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">05</span>Watchlist</span><span>this browser only</span></div><div class="pane-b flush" data-watchlist><p class="pane-b gap">Loading…</p></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">06</span>Live paper P&L</span><a href="/pnl/">open</a></div><div class="pane-b flush" data-pnl><p class="pane-b gap">Loading…</p></div></section>
<section class="pane span-12"><div class="pane-h"><span><span class="idx">07</span>Data health</span><span>from the source feed</span></div><div class="pane-b"><dl class="kv"><dt>Stocks priced</dt><dd>{f0(cov.priced)} of {f0(F.meta.attempted)}</dd><dt>With annual statements</dt><dd>{pct(cov.statements_pct)}</dd><dt>With a return-on-capital figure</dt><dd>{pct(cov.roce_pct)}</dd><dt>Prices behind the latest session</dt><dd>{f0(cov.behind)}</dd><dt>Source job</dt><dd>{F.meta.job_status?.status ?? 'unknown'} · {F.meta.job_status?.detail ?? ''}</dd></dl><p class="src">Quotes in the tape are delayed and unofficial, via Yahoo Finance. The daily feed refreshes about 05:45 IST each trading day; the site rebuilds after it. Educational; not advice.</p></div></section>
</div>
<script src="../../scripts/watch.ts"></script><script src="../../scripts/pnl.ts"></script></Terminal>
