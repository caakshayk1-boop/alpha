---
import Terminal from '../../layouts/Terminal.astro'; import Delta from '../../components/Delta.astro'; import Icon from '../../components/Icon.astro';
import { loadFeed, num, pct, spct, f0, f1, cohorts } from '../../lib/feed.ts'; import { sectors } from '../../lib/stats.ts'; import { brief } from '../../lib/brief.ts'; import { facts } from '../../lib/insight.ts'; import { dmy, tradeRows, bookState } from '../../lib/view.ts'; import { ledger, markFn } from '../../lib/data.ts'; import { MAX_OPEN } from '../../lib/book.ts';
const F = loadFeed(); const b = F.meta.breadth; const sec = sectors(F.rows); const B = brief(F); const co = cohorts(); const cov = F.meta.coverage; const L = ledger(), mark = markFn(); const book = bookState(L, mark); const calls = tradeRows(L, mark).filter((t) => t.status === 'open' || t.status === 'pending'); const money = (x: number) => '₹' + x.toLocaleString('en-IN');
const top = [...F.rows].filter((r) => num(r, 'comp') != null && r.liquid).sort((a, c) => c.comp - a.comp || a.sym.localeCompare(c.sym)).slice(0, 6);
const moved = F.rows.filter((r) => num(r.delta, 'comp') != null); const up = [...moved].sort((a, c) => c.delta.comp - a.delta.comp).slice(0, 4), dn = [...moved].sort((a, c) => a.delta.comp - c.delta.comp).slice(0, 4);
const idx = [['NIFTY', 'Nifty 50'], ['BANKNIFTY', 'Bank Nifty'], ['SENSEX', 'Sensex'], ['NIFTYIT', 'Nifty IT'], ['INDIAVIX', 'India VIX']]; const tone = (v: number | null) => (v == null ? '' : v >= 2 ? 'up2' : v > 0 ? 'up1' : v <= -2 ? 'dn2' : v < 0 ? 'dn1' : '');
const withPnl = calls.filter((c) => c.pnl != null).sort((a, c) => (c.pnl as number) - (a.pnl as number)); const best = withPnl[0], worst = withPnl.at(-1);
const W = [['pulse', 'Market pulse'], ['book', 'The book'], ['brief', 'Daily brief'], ['leaders', 'Score leaders'], ['movers', 'Score movers'], ['watch', 'Watchlist'], ['pnl', 'Live paper P&L'], ['calc', 'Position-size calculator'], ['health', 'Data health']];
import Disclaimer from '../../components/Disclaimer.astro';
---
<Terminal title="Terminal" description="Widgets: market pulse, the paper book, the daily brief, score leaders and movers, your watchlist, live paper P&L and a position-size calculator. Educational; not advice.">
<Fragment slot="tools"><button class="tchip" type="button" data-customize aria-haspopup="dialog" aria-expanded="false"><Icon name="filter" size={14} />Widgets</button><div class="wmenu" data-wmenu hidden role="dialog" aria-label="Choose widgets"><div class="label">Show on this device</div>{W.map(([id, label]) => <label class="wopt"><input type="checkbox" data-wtoggle={id} checked><span>{label}</span></label>)}<button class="tchip" type="button" data-wreset>Show all</button></div></Fragment>
<div class="t-title"><h1>Terminal</h1><span class="stamp">daily data as of {dmy(F.asOf)} · built {dmy(F.builtOn)} · <span data-q-age>waiting for first quote…</span></span></div>
<Disclaimer />
<div class="tape" aria-label="Index quotes, delayed">{idx.map(([k, n]) => <div class="q" data-q={k}><span class="s">{n}</span><span class="p" data-q-px>—</span><span class="c" data-q-chg>—</span></div>)}</div>
<div class="panes">
<section class="pane span-4" data-widget="pulse"><div class="pane-h"><span>Market pulse</span><span>{pct(b.above200, 0)} above 200-day</span></div><div class="pane-b"><div class="hero-n"><div><div class="label">Advancing</div><div class="big-n up" data-count={b.advancing}>{b.advancing}</div></div><div><div class="label">Declining</div><div class="big-n down" data-count={b.declining}>{b.declining}</div></div></div><div class="split mt4" role="img" aria-label={`${b.advancing} advancing, ${b.declining} declining`}><b class="a" data-grow={(b.advancing / (b.advancing + b.declining)) * 100}></b><b class="d" data-grow={(b.declining / (b.advancing + b.declining)) * 100}></b></div>
<div class="heat mt4">{sec.map((s) => <a href={`/screener/?sector=${encodeURIComponent(s.sector)}`} data-t={tone(s.r1m)} title={`${s.n} stocks · 1-month median · opens the screener`}><span class="n">{s.sector}</span><span class="v">{spct(s.r1m)}</span></a>)}</div></div></section>
<section class="pane span-4" data-widget="book"><div class="pane-h"><span>The book</span><a href="/calls/">open</a></div><div class="pane-b">{book ? <><div class="hero-n"><div><div class="label">Open calls</div><div class="big-n">{book.open}<small> of {MAX_OPEN}</small></div></div><div><div class="label">Cash</div><div class="big-n">{money(book.cash)}</div></div></div><div class="meter mt4"><b data-w={(book.deployed / book.capital) * 100}></b></div><p class="src">{Math.round((book.deployed / book.capital) * 100)}% of {money(book.capital)} invested. Cash is a position.</p>
{best && worst && <dl class="kv"><dt>Best call so far</dt><dd><a href={`/stock/${best.symbol}/`}>{best.symbol}</a> <Delta value={best.pnl} decimals={0} /></dd><dt>Weakest call so far</dt><dd><a href={`/stock/${worst.symbol}/`}>{worst.symbol}</a> <Delta value={worst.pnl} decimals={0} /></dd></dl>}</> : <p class="gap">The book has not started.</p>}</div></section>
<section class="pane span-4" data-widget="brief"><div class="pane-h"><span>Daily brief</span><span>by rule, from the feed</span></div><div class="pane-b prose-t"><p class="lead">{B.headline}</p>{B.paragraphs.slice(0, 2).map((p) => <p class="small">{p}</p>)}</div></section>
<section class="pane span-6" data-widget="leaders"><div class="pane-h"><span>Score leaders</span><a href="/screener/?sort=comp">open</a></div><div class="pane-b flush"><table class="t-table"><thead><tr><th>Stock</th><th class="num">Score</th><th>Stands out on</th></tr></thead><tbody>{top.map((r) => { const fl = facts(r, co); const f = fl.find((x) => x.good === true) ?? fl[0]; return <tr><td><a href={`/stock/${r.sym}/`} data-vt={`stock-${r.sym}`}>{r.sym}</a></td><td class="num">{f0(r.comp)}</td><td class="src">{f ? f.label : 'No single standout'}</td></tr>; })}</tbody></table></div></section>
<section class="pane span-6" data-widget="movers"><div class="pane-h"><span>Score movers</span><span>since {B.compared ? dmy(B.compared) : 'last build'}</span></div><div class="pane-b flush"><div class="grid g2"><table class="t-table"><tbody>{up.map((r) => <tr><td><a href={`/stock/${r.sym}/`}>{r.sym}</a></td><td class="num up">+{f1(r.delta.comp)}</td></tr>)}</tbody></table><table class="t-table"><tbody>{dn.map((r) => <tr><td><a href={`/stock/${r.sym}/`}>{r.sym}</a></td><td class="num down">−{f1(Math.abs(r.delta.comp))}</td></tr>)}</tbody></table></div></div></section>
<section class="pane span-4" data-widget="watch"><div class="pane-h"><span>Watchlist</span><span>this browser only</span></div><div class="pane-b flush" data-watchlist><p class="pad gap">Loading…</p></div></section>
<section class="pane span-4" data-widget="pnl"><div class="pane-h"><span>Live paper P&amp;L</span><a href="/gate/">The Gate</a></div><div class="pane-b flush" data-pnl><p class="pad gap">Loading…</p></div></section>
<section class="pane span-4" data-widget="calc"><div class="pane-h"><span>Position-size calculator</span><span>paper</span></div><div class="pane-b"><form class="calc" data-calc novalidate><label>Account (₹)<input type="text" inputmode="numeric" name="acct" value="1000000" autocomplete="off"></label><label>Risk per trade (%)<input type="text" inputmode="decimal" name="risk" value="1" autocomplete="off"></label><label>Entry (₹)<input type="text" inputmode="decimal" name="entry" placeholder="100" autocomplete="off"></label><label>Stop (₹)<input type="text" inputmode="decimal" name="stop" placeholder="95" autocomplete="off"></label><output data-calc-out aria-live="polite">Enter an entry and a stop below it.</output></form></div></section>
<section class="pane span-12" data-widget="health"><div class="pane-h"><span>Data health</span><span>from the source feed</span></div><div class="pane-b"><dl class="kv"><dt>Stocks priced</dt><dd>{f0(cov.priced)} of {f0(F.meta.attempted)}</dd><dt>With annual statements</dt><dd>{pct(cov.statements_pct)}</dd><dt>With a return-on-capital figure</dt><dd>{pct(cov.roce_pct)}</dd><dt>Prices behind the latest session</dt><dd>{f0(cov.behind)}</dd><dt>Source job</dt><dd>{F.meta.job_status?.status ?? 'unknown'} · {F.meta.job_status?.detail ?? ''}</dd></dl><p class="src">Quotes in the tape are delayed and unofficial, via Yahoo Finance. The daily feed refreshes about 05:45 IST each trading day; the site rebuilds after it. Educational; not advice.</p></div></section>
</div>
<script src="../../scripts/watch.ts"></script><script src="../../scripts/pnl.ts"></script><script src="../../scripts/widgets.ts"></script></Terminal>
