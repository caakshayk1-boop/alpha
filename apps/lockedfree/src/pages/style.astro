---
import Base from '../layouts/Base.astro'; import Icon from '../components/Icon.astro'; import Delta from '../components/Delta.astro'; import StatBlock from '../components/StatBlock.astro';
const swatches = [['paper', '#FAF7F0'], ['card', '#FFFDF8'], ['ink', '#16211B'], ['ink-muted', '#5C665E'], ['hairline', '#E4DED0'], ['brand', '#0E5E42'], ['up', '#0F6B4A'], ['down', '#C8481F'], ['down-ink', '#A8321F'], ['warn', '#C77F0A'], ['warn-ink', '#8A5600']];
---
<Base title="Style" description="Living style page for the Rulebook design system." path="/style/">
<div class="wrap hero"><span class="label eyebrow">Design system</span><h1>The paper ledger, in parts.</h1><p class="lede">Tokens, type, icons, controls and states, as built. This page is the reference the rest of the site is checked against. It is not indexed.</p></div>
<section class="wrap block"><h2>Colour</h2><div class="grid g4">{swatches.map(([n, h]) => <div class="card"><div class="swatch" data-sw={n}></div><div class="label">{n}</div><div class="stamp">{h}</div></div>)}</div><p class="small muted">Direction is never colour alone: a sign and an arrow always travel with it. <Delta value={2.4} suffix="%" /> <Delta value={-1.8} suffix="%" /> <Delta value={null} /></p></section>
<section class="wrap block"><h2>Type</h2><div class="display-xl">Fira Sans display, 56</div><h1>Page title, 36</h1><h2>Section title, 24</h2><p>Fira Sans body, 16. Tabular figures for data: 1,234.56 ₹98,765</p><p class="fig">JetBrains Mono: 18 Nov 2026 · ₹1,00,000 · +1.50 R</p><p class="stamp">as of 18 Nov 2026 · stamp, 12</p></section>
<section class="wrap block"><h2>Icons</h2><p class="row">{['arrow-up-right', 'arrow-down-right', 'check', 'x', 'help', 'lock', 'filter', 'gate', 'plan', 'ledger', 'shield', 'clock', 'info'].map((i) => <span class="chip"><Icon name={i} />{i}</span>)}</p></section>
<section class="wrap block"><h2>Controls and states</h2><p class="row"><button class="btn">Primary</button><button class="btn ghost">Secondary</button><button class="btn" disabled>Disabled</button><span class="pill">default</span><span class="pill warn">stale</span><span class="pill pass">pass</span><span class="pill fail">fail</span></p>
<div class="grid g3"><StatBlock label="Expectancy" value="+0.42 R" n={13} asOf="2026-11-18" /><StatBlock label="Closed trades" value="42" n={42} asOf="2026-11-18" perf={false} /><div class="card"><span class="label">Missing</span><p class="missing" title="missing">— <span class="small">missing, never zero</span></p></div></div></section>
<section class="wrap block"><h2>Motion</h2><p>120 / 200 / 320 / 420 ms. Ease-out for entrances, ease-in-out for movement. Nothing loops. Reduced motion turns it all off.</p><div class="card"><button class="btn" data-press>Press me (scale 0.97, 120ms)</button></div></section></Base>
