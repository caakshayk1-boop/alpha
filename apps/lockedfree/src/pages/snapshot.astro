---
import Terminal from '../layouts/Terminal.astro'; import { loadFeed, num, pct, spct, f0, f1 } from '../lib/feed.ts'; import { sectors, vals, hist } from '../lib/stats.ts'; import { histogram, scatter } from '../lib/svg.ts'; import { dmy } from '../lib/view.ts';
const F = loadFeed(); const b = F.meta.breadth, ch = F.meta.changes, sec = sectors(F.rows), v = F.meta.vet;
const pe = hist(vals(F.rows, 'pe').filter((x) => x > 0), [10, 15, 20, 30, 40, 60, 100]), peL = ['<10', '10–15', '15–20', '20–30', '30–40', '40–60', '60–100', '100+'];
const r3 = hist(vals(F.rows, 'r3m'), [-30, -20, -10, 0, 10, 20, 40]), r3L = ['<−30', '−30…−20', '−20…−10', '−10…0', '0…10', '10…20', '20…40', '40+'];
const risk = ['LOW', 'MEDIUM', 'HIGH'].map((l) => [l, F.rows.filter((r) => r.risk?.level === l).length]); const pts = F.rows.filter((r) => num(r, 'q') != null && num(r, 'v') != null).map((r) => ({ x: r.q, y: r.v, t: `${r.sym}: quality ${Math.round(r.q)}, value ${Math.round(r.v)}` }));
const moved = F.rows.filter((r) => num(r.delta, 'comp') != null); const up = [...moved].sort((a, c) => c.delta.comp - a.delta.comp).slice(0, 6), dn = [...moved].sort((a, c) => a.delta.comp - c.delta.comp).slice(0, 6);
---
<Terminal title="Snapshot" description="Market snapshot: breadth, sector table, valuation and momentum distributions, quality against value, and what changed in the scores since the last build." live={false}>
<div class="t-title"><h1>Snapshot</h1><span class="stamp">daily data as of {dmy(F.asOf)} · {F.rows.length} stocks</span></div>
<div class="panes">
<section class="pane span-4"><div class="pane-h"><span><span class="idx">01</span>Breadth</span></div><div class="pane-b"><div class="split" role="img" aria-label={`${b.advancing} advancing, ${b.declining} declining`}><b class="a" data-grow={(b.advancing / (b.advancing + b.declining)) * 100}></b><b class="d" data-grow={(b.declining / (b.advancing + b.declining)) * 100}></b></div><dl class="kv mt4"><dt>Advancing · declining</dt><dd>{b.advancing} · {b.declining}</dd><dt>Above 20 · 50 · 200-day</dt><dd>{pct(b.above20, 0)} · {pct(b.above50, 0)} · {pct(b.above200, 0)}</dd><dt>At a 52-week high</dt><dd>{b.at_52w_high}</dd><dt>Median 1-month return</dt><dd>{spct(b.median_1m)}</dd><dt>Source's reading</dt><dd>{b.label}</dd></dl></div></section>
<section class="pane span-8"><div class="pane-h"><span><span class="idx">02</span>Sectors</span><span>medians</span></div><div class="pane-b flush"><table class="t-table cards"><thead><tr><th>Sector</th><th class="num">Stocks</th><th class="num">1D</th><th class="num">1M</th><th class="num">3M</th><th class="num">P/E</th><th class="num">ROCE</th><th class="num">Above 200-day</th></tr></thead><tbody>{sec.map((s) => <tr><td><a href={`/screener/?sector=${encodeURIComponent(s.sector)}`}>{s.sector}</a></td><td class="num">{s.n}</td><td class="num">{spct(s.r1d, 2)}</td><td class="num">{spct(s.r1m)}</td><td class="num">{spct(s.r3m)}</td><td class="num">{f1(s.pe)}</td><td class="num">{pct(s.roce)}</td><td class="num">{pct(s.above200, 0)}</td></tr>)}</tbody></table></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">03</span>P/E distribution</span><span>profitable stocks</span></div><div class="pane-b"><Fragment set:html={histogram(pe, peL, 'Number of stocks by price-to-earnings band').replace('class="svg"', 'class="svg anim"')} /></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">04</span>Three-month return distribution</span><span>% bands</span></div><div class="pane-b"><Fragment set:html={histogram(r3, r3L, 'Number of stocks by three-month return band').replace('class="svg"', 'class="svg anim"')} /></div></section>
<section class="pane span-8"><div class="pane-h"><span><span class="idx">05</span>Quality against value</span><span>each dot is one stock, hover for the name</span></div><div class="pane-b"><Fragment set:html={scatter(pts, 'Quality score', 'Value score', 'Quality score against value score for every tracked stock')} /></div></section>
<section class="pane span-4"><div class="pane-h"><span><span class="idx">06</span>Data cautions</span></div><div class="pane-b"><dl class="kv">{risk.map(([l, n]) => <><dt>{l[0] + l.slice(1).toLowerCase()} caution level</dt><dd>{n}</dd></>)}<dt>Passing the source's quality checks</dt><dd>{v?.cleared ?? '—'}</dd><dt>Held back by a check</dt><dd>{v?.held ?? '—'}</dd></dl></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">07</span>Biggest score rises</span><span>since {ch?.compared_with ? dmy(ch.compared_with) : 'last build'}</span></div><div class="pane-b flush"><table class="t-table"><tbody>{up.map((r) => <tr><td><a href={`/stock/${r.sym}/`}>{r.sym}</a></td><td class="num up">+{f1(r.delta.comp)}</td></tr>)}</tbody></table></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">08</span>Biggest score falls</span><span>since {ch?.compared_with ? dmy(ch.compared_with) : 'last build'}</span></div><div class="pane-b flush"><table class="t-table"><tbody>{dn.map((r) => <tr><td><a href={`/stock/${r.sym}/`}>{r.sym}</a></td><td class="num down">−{f1(Math.abs(r.delta.comp))}</td></tr>)}</tbody></table></div></section>
</div><p class="src">Scores are the source feed's composite of quality, growth, value and trend. Distributions count stocks with the input present; missing values are not counted. Educational; not advice.</p></Terminal>
