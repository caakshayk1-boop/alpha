---
import PageIntro from '../components/PageIntro.astro';
import Terminal from '../layouts/Terminal.astro'; import { loadFeed } from '../lib/feed.ts'; import { dmy } from '../lib/view.ts'; const F = loadFeed();
---
<Terminal title="Stocks" description="Filter and sort tracked NSE stocks by returns, valuation, quality, growth and trend. Missing data is left out, never guessed. Educational; not advice." live>
<PageIntro title="Stocks" summary="Filter the tracked NSE stocks by published measures and open a company to inspect its inputs.">{F.rows.length} stocks · daily data as of {dmy(F.asOf)} · sorted and exported using the dated close. The first 25 visible rows can also show delayed quotes.</PageIntro>
<section class="pane"><div class="pane-h"><span><span class="idx">01</span>Rules</span><span data-count-shown role="status">First 25 stocks alphabetically · close {F.asOf}</span></div><div class="pane-b"><div class="chipbar" data-presets aria-label="Preset rules"></div><p class="src mt3" data-why data-u="mt3"></p>
<div class="row mt3" data-u="mt3"><label class="src">Sector <select data-f-sector aria-label="Sector"><option value="">All sectors</option></select></label><label class="src">Find <input type="search" data-f-text placeholder="symbol or name" aria-label="Find a stock"></label><span class="src">Columns</span><span class="chipbar" data-groups></span><button class="tchip" type="button" data-csv>Download CSV</button></div></div></section>
<section class="pane"><div class="pane-b flush"><div class="scroll tall"><table class="t-table"><caption class="src">Stocks by selected filters · dated close {F.asOf}</caption><thead><tr data-head><th scope="col">Stock</th><th scope="col">Close ₹</th></tr></thead><tbody data-body>{F.rows.slice(0,25).map(r => <tr><td><a href={`/stock/${r.sym}/`}>{r.sym}</a></td><td>{r.price ?? "—"}</td></tr>)}</tbody></table></div></div><div class="pane-b"><button type="button" class="tchip" data-prev hidden>Previous page</button> <span class="src" data-more role="status"></span> <button type="button" class="tchip" data-next hidden>Next page</button></div></section>
<p class="src">For banks and NBFCs, debt/equity and CFO/PAT describe a different business model; do not interpret them like industrial-company ratios.</p><noscript><p>Enable JavaScript to filter the stock list. <a href="/calls/">Published calls and screens</a> remain available.</p></noscript><p class="src"><a href="/method/#numbers">Metric definitions</a>. ROCE means return on capital employed. CFO/PAT compares operating cash flow to profit after tax. Presets are plain rules, shown in full when selected. A stock missing any input a rule needs is left out of that result rather than guessed. Educational information, not a recommendation. Press 1–5 to switch rooms, / to search.</p>
<script src="../scripts/screener.ts"></script><script src="../scripts/watch.ts"></script></Terminal>
