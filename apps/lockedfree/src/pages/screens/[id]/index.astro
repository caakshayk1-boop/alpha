---
import Base from '../../../layouts/Base.astro'; import StatBlock from '../../../components/StatBlock.astro'; import EquityCard from '../../../components/EquityCard.astro'; import Icon from '../../../components/Icon.astro'; import Delta from '../../../components/Delta.astro';
import { SCREENS } from '../../../lib/screens.ts'; import { ledger, markFn } from '../../../lib/data.ts'; import { agg, dmy, signed, inr, tradeRows } from '../../../lib/view.ts'; import { nextSaturday } from '../../../lib/dates.ts';
export function getStaticPaths() { return SCREENS.map((s) => ({ params: { id: s.id }, props: { s } })); }
const { s } = Astro.props; const L = ledger(); const a = agg(L, s.id); const run = L.runs.filter((r) => r.screen_id === s.id).pop(); const tr = L.transitions.filter((t) => t.screen_id === s.id).pop();
const rows = tradeRows(L, markFn()).filter((t) => t.screen_id === s.id); const next = nextSaturday(L.as_of ?? new Date().toISOString().slice(0, 10));
const items = run ? [...(tr?.entered ?? []).map((x) => [x, 'entered']), ...(tr?.still_in ?? []).map((x) => [x, 'still-in']), ...(tr?.exited ?? []).map((x) => [x, 'exited'])] : [];
---
<Base title={s.name} description={`${s.name}: ${s.short} Paper-only, educational. Weekly list, changes, and the full track record.`} charts flip og={`/og/screen-${s.id}.png`}>
<div class="wrap hero"><div class="card" data-vt={`screen-${s.id}`}><span class="label eyebrow">Screen · version {s.version}</span><h1>{s.name}</h1><p class="muted" data-u="mb3">{s.short}</p>
<p class="stamp">{run ? `Run of ${dmy(run.run_date)} · universe ${run.universe_n} · not scorable ${run.not_scorable_n}` : 'No run yet'} · next refresh {dmy(next)}</p>
<p class="row"><a class="btn" href={`/plan/?screen=${s.id}`}><Icon name="plan" size={18} />Follow this screen (paper)</a><a class="btn ghost" href={`/screens/${s.id}/methodology/`}>Rules and weaknesses</a><a class="btn ghost" href={`/screens/${s.id}/archive/`}>Archive</a></p></div></div>
<section class="wrap block"><span class="label eyebrow">This week</span>
{!run && <div class="sit"><div class="big">No run has been recorded yet.</div><p class="muted">The first run is the Friday close after launch, published on Saturday {dmy(next)}. Until then there is no list, and no list is invented.</p></div>}
{run && run.passed.length === 0 && <div class="sit"><div class="big">0 stocks pass all rules this week. Cash is a position.</div><p class="muted">Sitting out is a result, and it is recorded as one. {run.near_miss?.length ? `${run.near_miss.length} ${run.near_miss.length === 1 ? 'is' : 'are'} one criterion away:` : 'None came within one criterion.'}</p>
{run.near_miss && run.near_miss.length > 0 && <table class="cards"><thead><tr><th>Stock</th><th>Failing criterion</th><th class="num">Gap</th></tr></thead><tbody>{run.near_miss.map((n) => <tr><td data-label="Stock"><a href={`/screens/${s.id}/${n.symbol}/`}>{n.symbol}</a></td><td data-label="Failing criterion">{n.failed_rule}</td><td class="num" data-label="Gap">{n.gap}</td></tr>)}</tbody></table>}</div>}
{run && run.passed.length > 0 && <div data-shortlist><div class="row" role="group" aria-label="Filter the list"><button class="chip" data-filter="all" aria-pressed="true">All ({items.length})</button><button class="chip" data-filter="entered" aria-pressed="false">Entered ({tr?.entered.length ?? 0})</button><button class="chip" data-filter="still-in" aria-pressed="false">Still in ({tr?.still_in.length ?? 0})</button><button class="chip" data-filter="exited" aria-pressed="false">Exited ({tr?.exited.length ?? 0})</button></div>
<ul class="chips" data-u="mt4">{items.map(([sym, st]) => <li data-state={st}><a class="chip" data-state={st} data-vt={`stock-${sym}`} href={`/screens/${s.id}/${sym}/`}>{sym}<span class="stamp">{st}</span></a></li>)}</ul></div>}
<p class="stamp" data-u="mt4">Changes compare with the previous run. A list is not a recommendation. It is the output of fixed rules.</p></section>
<section class="wrap block"><span class="label eyebrow">Track record</span><h2>What this screen has done</h2>
<div class="grid g4 card" data-u="my4"><StatBlock label="Picks" value={String(a?.n_picks ?? 0)} n={a?.n_picks ?? 0} asOf={L.as_of} perf={false} /><StatBlock label="Open · closed · void" value={`${a?.n_open ?? 0} · ${a?.n_closed ?? 0} · ${a?.n_void ?? 0}`} n={a?.n_picks ?? 0} asOf={L.as_of} perf={false} />
<StatBlock label="Win rate" value={a?.win_rate == null ? '—' : Math.round(a.win_rate * 100) + '%'} n={a?.n_closed ?? 0} asOf={L.as_of} /><StatBlock label="Expectancy" value={a?.expectancy_r == null ? '—' : signed(a.expectancy_r, 2, ' R')} n={a?.n_closed ?? 0} asOf={L.as_of} />
<StatBlock label="Average win" value={inr(a?.avg_win)} n={a?.n_closed ?? 0} asOf={L.as_of} /><StatBlock label="Average loss" value={inr(a?.avg_loss)} n={a?.n_closed ?? 0} asOf={L.as_of} /><StatBlock label="Max drawdown" value={a ? inr(a.max_drawdown) : '—'} n={a?.n_closed ?? 0} asOf={L.as_of} /><StatBlock label="Longest losing streak" value={String(a?.longest_losing_streak ?? 0)} n={a?.n_closed ?? 0} asOf={L.as_of} perf={false} /></div>
<EquityCard screen={s.id} title={`${s.name}, paper record`} vt={false} />
{rows.length > 0 && <div data-u="mt5"><h3>Every pick</h3><p class="stamp">as of {dmy(L.as_of)} · open positions are marked to the latest close</p><table class="cards"><thead><tr><th>Stock</th><th>Status</th><th>In</th><th>Out</th><th class="num">P&amp;L</th><th class="num">R</th></tr></thead><tbody>{rows.map((t) => <tr><td data-label="Stock">{t.symbol}</td><td data-label="Status">{t.reason}</td><td data-label="In">{dmy(t.entry)}</td><td data-label="Out">{t.exit ? dmy(t.exit) : '—'}</td><td class="num" data-label="P&L"><Delta value={t.pnl} decimals={0} /></td><td class="num" data-label="R"><Delta value={t.r} decimals={2} suffix=" R" /></td></tr>)}</tbody></table></div>}
</section></Base>
