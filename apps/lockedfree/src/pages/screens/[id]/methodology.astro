---
import Base from '../../../layouts/Base.astro'; import { SCREENS } from '../../../lib/screens.ts'; import { METHOD, COMMON } from '../../../lib/methodology.ts';
export function getStaticPaths() { return SCREENS.map((s) => ({ params: { id: s.id }, props: { s } })); }
const { s } = Astro.props; const m = METHOD[s.id];
---
<Base title={`${s.name}: methodology`} reading description={`The exact rules, thresholds, data sources, refresh cadence and known weaknesses of the ${s.name} screen.`}>
<div class="wrap hero prose"><span class="label eyebrow">Permanent methodology · version {s.version}</span><h1>{s.name}</h1><p class="lede">{s.short}</p><p class="small muted">Origin: {m.origin}</p></div>
<div class="wrap prose"><h2>The rules</h2><ol>{m.rules.map((r) => <li>{r}</li>)}</ol>
<h2 data-u="mt6">Data</h2><p>{COMMON.sources}</p><p>{COMMON.lag}</p><p>{COMMON.missing}</p>
<h2 data-u="mt6">Refresh</h2><p>{COMMON.cadence}</p>
<h2 data-u="mt6">How a listed name becomes a simulated trade</h2><p>{COMMON.mechanics}</p>
<h2 data-u="mt6">Known weaknesses</h2><ul>{m.weaknesses.map((w) => <li>{w}</li>)}<li>{COMMON.trail}</li></ul>
<h2 data-u="mt6">Changing the rules</h2><p>These rules are frozen. A change would create a new version of this screen with its own record. The old record is never rewritten.</p>
<p><a class="btn" href={`/screens/${s.id}/`}>Back to the list</a></p></div></Base>
