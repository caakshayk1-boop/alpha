---
import PracticePaths from '../components/PracticePaths.astro'; import '../styles/board.css'; import Base from '../layouts/Base.astro'; import Icon from '../components/Icon.astro';
import { ledger, benchmarkLast } from '../lib/data.ts'; import { agg, dmy, tradeRows, bookState } from '../lib/view.ts'; import { markFn } from '../lib/data.ts'; import { MAX_OPEN } from '../lib/book.ts'; import { SCREENS } from '../lib/screens.ts'; import { feedAvailable, loadFeed, cohorts, num, spct, f0, pct } from '../lib/feed.ts'; import { sectors } from '../lib/stats.ts'; import { facts } from '../lib/insight.ts'; import { brief } from '../lib/brief.ts'; import { RULES } from '../lib/exitrules.ts';
const L = ledger(); const all = agg(L, 'all'); const bk = bookState(L, markFn()); const openCalls = tradeRows(L, markFn()).filter((t) => t.status === 'open'); const staticPl = openCalls.every((t) => t.gross != null) ? openCalls.reduce((a, t) => a + (t.gross as number), 0) : null; const staticUp = openCalls.filter((t) => (t.gross ?? 0) > 0).length, staticDown = openCalls.filter((t) => (t.gross ?? 0) < 0).length; const callsData = openCalls.map((t) => ({ s: t.symbol, q: t.qty, e: t.entry_px, m: t.last })); const sname = (id: string) => SCREENS.find((x) => x.id === id)?.name ?? id; const F = feedAvailable() ? loadFeed() : null; const b = F?.meta.breadth; const sec = F ? sectors(F.rows) : []; const co = F ? cohorts() : null;
const top = F ? [...F.rows].filter((r) => num(r, 'comp') != null && r.liquid).sort((a, c) => c.comp - a.comp || a.sym.localeCompare(c.sym)).slice(0, 5) : [];
const tone = (v: number | null) => (v == null ? '' : v >= 2 ? 'u2' : v > 0 ? 'u1' : v <= -2 ? 'd2' : v < 0 ? 'd1' : '');
const rooms = [['01','Market brief','What changed today?','Read the dated breadth, sectors and paper book side by side.','/terminal/','Today'],['02','Paper book','Which calls are open?','Trace each simulated position back to its rules and see every exit.','/calls/','Calls'],['03','Stock screener','Which stocks meet my filters?','Compare the daily close, financial measures and screen results.','/screener/','Stocks']];
const marquee = [F ? `${F.rows.length} stocks tracked daily` : 'Stocks tracked daily', `${SCREENS.length} rules-based screens`, 'Every loss stays on the record', 'Cash is a position', 'Missing data stays missing', 'Paper-only, always', 'Delayed quotes, always labelled', 'Paper exits, not recommendations.'];
const BR = F ? brief(F) : null;
const indices: [string, string][] = [['NIFTY', 'Nifty 50'], ['SENSEX', 'Sensex'], ['BANKNIFTY', 'Bank Nifty'], ['INDIAVIX', 'India VIX']];
// live sector indices (Yahoo) paired with the daily feed's sector for the small "1M" line; a sector with no live quote shows a dash, never a guess
const secIdx: [string, string, string | null][] = [['NIFTYIT', 'IT', 'Technology'], ['BANKNIFTY', 'Bank', null], ['NIFTYFIN', 'Financial services', 'Financial Services'], ['NIFTYPHARMA', 'Pharma', 'Healthcare'], ['NIFTYAUTO', 'Auto', 'Consumer Cyclical'], ['NIFTYFMCG', 'FMCG', 'Consumer Defensive'], ['NIFTYMETAL', 'Metal', 'Basic Materials'], ['NIFTYENERGY', 'Energy', 'Energy'], ['NIFTYREALTY', 'Realty', 'Real Estate'], ['NIFTYINFRA', 'Infra', 'Industrials']];
const m1 = (name: string | null) => (name ? sec.find((x) => x.sector === name)?.r1m ?? null : null);
const rule = (id: string) => RULES[id];
---
<Base title="Rulebook" charts og="/og/default.png">
<div class="home">
<script type="application/json" id="bench-data" set:html={JSON.stringify(benchmarkLast())}></script>
<div class="hero-wrap" data-glow data-hero><div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div><div class="wrap hero-grid"><div class="hero-copy">
  <span class="kicker"><i></i>Rulebook · paper-only · every loss kept</span>
  <h1 class="display-xl hero-h">Practise investing <em>on paper.</em></h1>
  <p class="lede">Follow a stock from the day it’s chosen to the day it’s sold. See what the rules got right, what they missed, and try your own plan without putting money at risk.</p>
  <p class="page-context">Daily feed: {F ? dmy(F.asOf) : "unavailable"} · Ledger: {dmy(L.as_of)} · Quotes delayed and unofficial</p><div class="cta-row"><a class="btn mag" href="/calls/">Explore the paper portfolio <Icon name="arrow-up-right" size={18} /></a><a class="btn ghost" href="#rooms">Explore the sections →</a></div></div>
  <aside class="nowcard" aria-label="Market now" data-tilt><div class="nc-h"><span class="mchip" data-market-chip data-short data-state="closed"><i></i><span data-market-text>NSE</span></span><span class="nc-t">Market now</span></div>
    <div class="nc-b">{indices.map(([k, n]) => <div class="q" data-q={k}><span class="s">{n}</span><span class="p" data-q-px>—</span><span class="c" data-q-chg>—</span></div>)}</div>
    <div class="nc-f"><span class="stamp" data-q-age>Delayed quotes unavailable until loaded</span></div></aside></div>
  <div class="wrap"><div class="stats"><div><div class="v"><span data-count={F?.rows.length ?? 0}>{F?.rows.length ?? 0}</span></div><div class="l">Stocks tracked</div></div><div><div class="v"><span data-count={all?.n_open ?? 0}>{all?.n_open ?? 0}</span></div><div class="l">Open paper calls · max 30</div></div><div><div class="v"><span data-count={all?.n_closed ?? 0}>{all?.n_closed ?? 0}</span></div><div class="l">Closed paper trades</div></div><div><div class="v" data-track="home-asof">{F ? dmy(F.asOf).slice(0, -5) : '—'}<small>{F ? dmy(F.asOf).slice(-4) : ''}</small></div><div class="l">Data as of</div></div></div></div></div>

<section class="sec" id="rooms"><div class="wrap"><div class="sec-k" data-r>§ 01 — Explore</div><h2 class="sec-h" data-r>Explore the market and the paper book.</h2><p class="sec-p" data-r>Start with the question you want to answer.</p>
<div class="rooms">{rooms.map(([n, h, q, body, href, name], i) => <a class="room" href={href} data-r={String(i + 1)}><span class="no">{n} / 03 · {h}</span><span class="q" set:html={q}></span><p>{body}</p><span class="go">{name} <Icon name="arrow-up-right" size={16} /></span></a>)}</div></div></section>
<section class="sec"><div class="wrap"><div class="sec-k">§ 02 — Practice</div><h2 class="sec-h">Try the rules on paper.</h2><PracticePaths /></div></section>
<section class="sec" id="live"><div class="wrap"><div class="sec-k" data-r>§ 03 — Market data</div><h2 class="sec-h" data-r>What is moving, <em>right now.</em></h2><p class="sec-p" data-r>The board requests delayed quotes for sectors and public paper calls about every 15 seconds during market hours. Outside market hours they show the last close. A figure that cannot be fetched stays a dash.</p>
<div class="board" data-board><script type="application/json" id="calls-data" set:html={JSON.stringify(callsData)}></script>
<div class="bd-status"><span class="mchip" data-market-chip data-state="closed"><i></i><span data-market-text>NSE</span></span><span class="stamp" data-q-age>Delayed quotes unavailable until loaded</span></div>
<div class="bd-grid">
<div class="wd wd-sec" data-r><div class="wd-h"><span>Sectors today</span><span class="tag">live · delayed</span></div><div class="secs">{secIdx.map(([k, n, f]) => <div class="st" data-q={k} data-tone="flat"><span class="n">{n}</span><span class="v" data-q-chg>—</span><span class="p" data-q-px>—</span><span class="m">{m1(f) == null ? '' : `1M ${spct(m1(f))}`}</span></div>)}</div></div>
<div class="wd wd-calls" data-r="2"><div class="wd-h"><span>Public paper calls vs entry</span><span class="tag">live · delayed</span></div><div class="pl"><div><div class="l">Open paper P&amp;L, before charges</div><small class="src" data-home-price-basis>Ledger close {dmy(L.as_of)}</small><div class="big" data-close-date={L.as_of} data-pl>{staticPl == null ? '—' : (staticPl > 0 ? '+' : staticPl < 0 ? '−' : '') + '₹' + Math.abs(Math.round(staticPl)).toLocaleString('en-IN')}</div></div><div><div class="l">Calls up · down</div><div class="mid" data-pl-n>{staticUp} · {staticDown}</div></div></div><ul class="cchips">{openCalls.map((t) => <li><a href={`/stock/${t.symbol}/`} data-call={t.symbol} data-tone={t.gross_pct == null || t.gross_pct === 0 ? 'flat' : t.gross_pct > 0 ? 'u1' : 'd1'}><b>{t.symbol}</b><span data-call-pct>{t.gross_pct == null ? '—' : `${t.gross_pct > 0 ? '+' : t.gross_pct < 0 ? '−' : ''}${Math.abs(t.gross_pct).toFixed(2)}%`}</span></a></li>)}</ul><p class="src" data-pl-basis>Ledger marks: close of {dmy(L.as_of)}. Each call’s entry date is listed on Calls. A call whose price has not moved shows zero. Shown at the latest live price while the market is open, and at the last close otherwise.</p></div>
<a class="wd wd-more" href="/terminal/" data-r="3"><span class="wd-h"><span>The brief, breadth, regime and the book</span><span class="tag">on Today</span></span><span class="go">Open Today <Icon name="arrow-up-right" size={16} /></span></a>
</div></div></div></section>



<section class="sec"><div class="wrap split-2"><div data-r><div class="sec-k">§ 04 — Public record</div><h2 class="sec-h">Every call has an exit <em>before it has an entry.</em></h2><p class="sec-p">Each engine has its own stop and target, and no call is held longer than one month. The rules are written down first, so a loss is a rule doing its job, not a decision made in fear.</p>
<ul class="bullets"><li><Icon name="check" size={20} /><span><b>Exit at the first applicable rule.</b> Stop, target or one month. Screen removal also closes a call for {SCREENS.filter(s => rule(s.id).exit_on_drop).map(s => s.name).join(', ')}. {SCREENS.filter(s => !rule(s.id).exit_on_drop).map(s => s.name).join(', ')} holds through removal.</span></li><li><Icon name="check" size={20} /><span><b>At most 30 calls</b>{' '}from a ₹1 crore paper book, at most 4 in a sector</span></li><li><Icon name="check" size={20} /><span><b>Cash is a position</b>{' '}when nothing passes</span></li></ul><a class="btn mag" href="/calls/">See the calls <Icon name="arrow-up-right" size={18} /></a></div>
<div class="xr" data-r="2" aria-label="Stop and target for each engine">{SCREENS.map((s) => <div class="xr-row"><div class="xr-n">{s.name}</div><div class="xr-t" role="img" aria-label={`${s.name}: stop ${rule(s.id).stop_pct} percent${rule(s.id).trailing ? ' trailing' : ''}, target ${rule(s.id).target_pct} percent`}><i class="stop" data-pw={String(rule(s.id).stop_pct)}></i><em class="ax"></em><i class="tgt" data-pw={String(rule(s.id).target_pct)}></i></div><div class="xr-v"><span class="down">−{rule(s.id).stop_pct}%{rule(s.id).trailing ? ' trail' : ''}</span><span class="up">+{rule(s.id).target_pct}%</span></div></div>)}<p class="src">Entry at the close; the longest any call can run is one month. If a day touches both the stop and the target, the stop is assumed first.</p></div></div></section>

<section class="sec" id="join"><div class="wrap join"><div class="sec-k" data-r>§ 05 — Email notes</div><h2 class="sec-h" data-r>Get the screen note.</h2><p class="sec-p" data-r>Register for notes on what passed the stock screens. There is no fixed delivery schedule.</p>
<form data-r method="post" action="/api/subscribe" data-subscribe><div class="row2"><label class="sr" for="em" hidden>Email</label><input id="em" name="email" type="email" autocomplete="email" placeholder="you@example.com" required><button class="btn mag" type="submit">Join the list</button></div>
<label class="delivery-choice"><input name="delivery" type="checkbox" value="email-v1"> Send me confirmation and screen notes via Brevo when email delivery is available.</label><div hidden aria-hidden="true"><label for="hp">Leave empty</label><input id="hp" name="website" type="text" tabindex="-1" autocomplete="off"></div><input type="hidden" name="consent" value="weekly-note-v1"><p class="hint">We store your email, signup time and consent to send the screen note. <a href="/privacy/">Privacy and removal requests</a>. <span role="status" data-subscribe-msg></span><span class="signup-receipt" id="signup-saved">Interest recorded. Email delivery is not active for this signup.</span><span class="signup-receipt" id="signup-confirm">Confirmation requested. Check your inbox.</span><span class="signup-receipt" id="signup-retry">Interest recorded. Email confirmation could not be requested; please retry later.</span><span class="signup-receipt" id="email-confirmed">Thanks for following the confirmation link. You can unsubscribe in any note.</span></p></form></div></section>

</div>
<script src="../scripts/live.ts"></script><script src="../scripts/home.ts"></script><script src="../scripts/subscribe.ts"></script><script src="../scripts/panic.ts"></script></Base>
