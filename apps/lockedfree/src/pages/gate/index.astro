---
import Base from '../../layouts/Base.astro'; import GateHead from '../../components/GateHead.astro'; import { latestLists } from '../../lib/data.ts';
const names = [...new Set(Object.values(latestLists()).flatMap((l) => l.symbols))].sort();
---
<Base title="The Gate" description="A paper-trading terminal where a trade cannot be entered until a checklist, a computed position size and a stop exist.">
<GateHead current="/gate/" title="A trade cannot start until the rules exist." lede="Five checklist items, a computed size and an attached stop. Hit your own daily limit and the terminal locks until the next session." />
<div class="wrap"><script type="application/json" id="shortlist-data" set:html={JSON.stringify(names)}></script><div id="gate-root" data-view="entry"><noscript><p class="card">The Gate needs JavaScript to run, because your paper book is kept in your browser.</p></noscript></div></div>
<script src="../../app/gate.tsx"></script></Base>
