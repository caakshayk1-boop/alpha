---
import PageIntro from '../../components/PageIntro.astro';
import Terminal from '../../layouts/Terminal.astro'; import { latestLists, benchmarkLast, ledger } from '../../lib/data.ts';
---
<Terminal live={false} title="The Plan" description="A written one-page investment plan, goal buckets, and a systematic paper deployment rhythm with pre-committed auto-escalation.">
<div><PageIntro title="The Plan" summary="Build a dated plan in six steps. The monthly paper amount is split equally across your selected screen list.">Paper only · kept in this browser · screen list dates: {[...new Set(Object.values(latestLists()).map(list => list.asOf ?? "unavailable"))].join(", ")}</PageIntro>
<nav class="seg" aria-label="Practice"><a href="/gate/">The Gate</a><a href="/plan/" aria-current="page">The Plan</a></nav>
</div>
<div><script type="application/json" id="plan-data" set:html={JSON.stringify(latestLists())}></script><script type="application/json" id="bench-data" set:html={JSON.stringify(benchmarkLast())}></script>
<div id="plan-root" data-ledger-date={ledger().as_of}><noscript><p class="card">The Plan needs JavaScript to run, because it is kept in your browser.</p></noscript></div></div><script src="../../app/plan.tsx"></script></Terminal>
