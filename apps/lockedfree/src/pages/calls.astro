---
import Terminal from '../layouts/Terminal.astro'; import Delta from '../components/Delta.astro'; import EquityCard from '../components/EquityCard.astro'; import StatBlock from '../components/StatBlock.astro'; import Icon from '../components/Icon.astro';
import { SCREENS } from '../lib/screens.ts'; import { METHOD, COMMON } from '../lib/methodology.ts'; import { RATES, CHARGES_VERSION } from '../lib/charges.ts'; import { STOP_PCT } from '../lib/ledger.ts'; import { TICKET, MAX_OPEN, SECTOR_CAP, CAPITAL } from '../lib/book.ts';
import { ledger, markFn } from '../lib/data.ts'; import { agg, dmy, signed, inr, tradeRows, bookState } from '../lib/view.ts'; import { feedAvailable, loadFeed, num } from '../lib/feed.ts'; import { nextSaturday } from '../lib/dates.ts';
const L = ledger(), mark = markFn(), F = feedAvailable() ? loadFeed() : null; const book = bookState(L, mark); const all = agg(L, 'all'); const rows = tradeRows(L, mark); const open = rows.filter((t) => t.status === 'open' || t.status === 'pending'); const next = nextSaturday(L.as_of ?? new Date().toISOString().slice(0, 10));
const name = (id: string) => SCREENS.find((s) => s.id === id)?.name ?? id; const money = (x: number) => '₹' + x.toLocaleString('en-IN'); const sector = (s: string) => F?.bySym.get(s)?.sector ?? 'Unclassified'; const score = (s: string) => (F ? num(F.bySym.get(s), 'comp') : null);
const secCount: Record<string, number> = {}; for (const t of open) secCount[sector(t.symbol)] = (secCount[sector(t.symbol)] ?? 0) + 1;
const lastRuns = SCREENS.map((s) => L.runs.filter((r) => r.screen_id === s.id).pop()); const nt = new Map<string, { why: string; screens: string[] }>(); for (const r of lastRuns) for (const x of r?.skipped ?? []) { const e = nt.get(x.symbol) ?? { why: x.why, screens: [] }; e.screens.push(name(r!.screen_id)); nt.set(x.symbol, e); }
const ids = [...SCREENS.map((s) => s.id), 'all']; const exposure = book ? Math.round((book.deployed / book.capital) * 100) : 0;
---
<Terminal title="Calls" description="The paper book: the open calls, the four rules-based screens behind them, and the full public record with every loss and void. Educational and simulated." live={false} charts>
<div class="t-title"><h1>Calls</h1><span class="stamp">as of {dmy(L.as_of)} · prices are closes · Simulated — not real returns</span></div>
{book && <div class="widgets-row"><div class="w"><span class="label">Open calls</span><span class="big">{book.open}<small> of {MAX_OPEN}</small></span><div class="meter"><b data-w={(book.open / MAX_OPEN) * 100}></b></div></div><div class="w"><span class="label">Invested</span><span class="big">{exposure}<small>%</small></span><span class="src">{money(book.deployed)} of {money(book.capital)}</span></div><div class="w"><span class="label">Cash left</span><span class="big">{money(book.cash)}</span><span class="src">cash is a position</span></div><div class="w"><span class="label">Closed trades</span><span class="big">{all?.n_closed ?? 0}</span><span class="src">{all?.honesty ?? ''}</span></div></div>}
<div data-tabs>
<div class="tabbar" role="tablist" aria-label="Calls" hidden><button role="tab" data-tab="open" aria-selected="true">Open calls ({open.length})</button><button role="tab" data-tab="screens" aria-selected="false">The four screens</button><button role="tab" data-tab="record" aria-selected="false">The record</button></div>
<section role="tabpanel" id="tab-open" class="pane"><div class="pane-b flush">
{open.length === 0 ? <div class="sit pad"><div class="big">No open calls.</div><p class="muted">When nothing passes, the book stays in cash. That is a position, and it is recorded as one.</p></div> : <div class="scroll"><table class="t-table"><thead><tr><th>Stock</th><th>Screen</th><th>Sector</th><th>In</th><th class="num">Entry ₹</th><th class="num">Score</th><th class="num">P&amp;L</th><th class="num">R</th></tr></thead><tbody>{open.map((t) => <tr><td><a href={`/stock/${t.symbol}/`} data-vt={`stock-${t.symbol}`}>{t.symbol}</a></td><td>{name(t.screen_id)}</td><td class="src">{sector(t.symbol)}</td><td>{dmy(t.entry)}</td><td class="num">{t.entry_px?.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td><td class="num">{score(t.symbol) == null ? '—' : Math.round(score(t.symbol)!)}</td><td class="num"><Delta value={t.pnl} decimals={0} /></td><td class="num"><Delta value={t.r} decimals={2} suffix=" R" /></td></tr>)}</tbody></table></div>}
<p class="src pad">P&amp;L is against the latest close, after buy-side charges. A call is a passer the book took: at most {MAX_OPEN} open, at most {SECTOR_CAP} per sector, {money(TICKET)} each. By sector: {Object.entries(secCount).sort((a, b) => b[1] - a[1]).map(([k, v]) => `${k} ${v}`).join(' · ') || '—'}.</p></div></section>
<section role="tabpanel" id="tab-screens" class="pane"><div class="pane-b"><div class="grid g2">{SCREENS.map((s, i) => { const run = lastRuns[i]; const m = METHOD[s.id]; const a = agg(L, s.id); return <article class="card" id={s.id}><div class="card-head"><h2>{s.name}</h2><span class="pill">v{s.version}</span></div><p class="muted">{s.short}</p>
<p class="stamp">{run ? `${run.run_date ? 'Run of ' + dmy(run.run_date) : ''} · universe ${run.universe_n} · ${run.passed.length} pass · ${run.listed?.length ?? run.passed.length} listed · not scorable ${run.not_scorable_n} · next refresh ${dmy(next)}` : 'No run yet'}</p>
{run && run.passed.length === 0 ? <div class="sit"><div class="big">0 stocks pass all rules this week. Cash is a position.</div>{run.near_miss?.length ? <p class="muted">{run.near_miss.length} are one criterion away: {run.near_miss.slice(0, 6).map((n) => `${n.symbol} (${n.failed_rule})`).join('; ')}.</p> : null}</div> : <ul class="chips">{(run?.listed ?? run?.passed ?? []).map((sym) => <li><a class="chip" data-state={run!.taken?.includes(sym) || open.some((o) => o.symbol === sym && o.screen_id === s.id) ? 'call' : 'skipped'} href={`/stock/${sym}/`}>{sym}<span class="stamp">{open.some((o) => o.symbol === sym && o.screen_id === s.id) ? 'call' : 'listed'}</span></a></li>)}</ul>}
<details class="table-alt"><summary>The rules and what can go wrong</summary><ol>{m.rules.map((r) => <li>{r}</li>)}</ol><p class="src">Origin: {m.origin}</p><ul>{m.weaknesses.map((w) => <li>{w}</li>)}<li>{COMMON.trail}</li></ul></details>
<p class="row"><a class="btn ghost" href={`/plan/?screen=${s.id}`}><Icon name="plan" size={16} />Follow this screen (paper)</a><span class="pill">n = {a?.n_closed ?? 0} closed</span></p></article>; })}</div>
<details class="table-alt mt4"><summary>How a pass becomes a call, and what the simulation leaves out</summary><p>{COMMON.sources}</p><p>{COMMON.cadence}</p><p>{COMMON.lag}</p><p>{COMMON.book}</p><p>{COMMON.mechanics}</p><p>{COMMON.basis}</p><p>{COMMON.size}</p><p>{COMMON.missing}</p><p class="src">Charges, schedule {CHARGES_VERSION}: delivery equity. STT {RATES.sttPct}% on both sides, exchange {RATES.exchangePct}%, SEBI {RATES.sebiPct}%, stamp duty {RATES.stampBuyPct}% on buys, GST {RATES.gstPct}% on fees, a flat ₹{RATES.dpSellFlat} depository charge on sells. Fixed {STOP_PCT}% stop for R. Rates are starting values to be checked against the official schedules.</p></details></div></section>
<section role="tabpanel" id="tab-record" class="pane"><div class="pane-b"><EquityCard vt={false} />
<h3 class="t-h2">Scoreboard <span class="src">every figure shows its n · as of {dmy(L.as_of)}</span></h3><div class="scroll"><table class="t-table"><thead><tr><th>Screen</th><th class="num">Calls</th><th class="num">Open</th><th class="num">Closed (n)</th><th class="num">Void</th><th class="num">Win rate</th><th class="num">Expectancy</th><th class="num">Max drawdown</th></tr></thead><tbody>{ids.map((id) => { const a = agg(L, id); return <tr><td><strong>{id === 'all' ? 'All screens' : name(id)}</strong>{a?.honesty && <div class="src" data-warn>{a.honesty}</div>}</td><td class="num">{a?.n_picks ?? 0}</td><td class="num">{a?.n_open ?? 0}</td><td class="num">{a?.n_closed ?? 0}</td><td class="num">{a?.n_void ?? 0}</td><td class="num">{a?.win_rate == null ? '—' : Math.round(a.win_rate * 100) + '%'}</td><td class="num">{a?.expectancy_r == null ? '—' : signed(a.expectancy_r, 2, ' R')}</td><td class="num">{a ? inr(a.max_drawdown) : '—'}</td></tr>; })}</tbody></table></div>
<p class="src">Win rate and expectancy use closed trades only. 1R is the original risk to a fixed {STOP_PCT}% stop. Nothing here can be deleted. Simulated — not real returns.</p>
<h3 class="t-h2">Closed trades <span class="src">n = {rows.filter((t) => t.status === 'closed').length} · every exit, wins and losses alike</span></h3>{rows.filter((t) => t.status === 'closed').length === 0 ? <p class="gap">No call has closed yet. Closed trades, including every loss, are listed here the day they close.</p> : <div class="scroll short"><table class="t-table"><thead><tr><th>Stock</th><th>Screen</th><th>In</th><th>Out</th><th>Why it closed</th><th class="num">P&amp;L</th><th class="num">R</th></tr></thead><tbody>{rows.filter((t) => t.status === 'closed').sort((a, b) => (b.exit ?? '').localeCompare(a.exit ?? '')).slice(0, 150).map((t) => <tr><td><a href={`/stock/${t.symbol}/`}>{t.symbol}</a></td><td>{name(t.screen_id)}</td><td>{dmy(t.entry)}</td><td>{dmy(t.exit)}</td><td class="src">{t.reason}</td><td class="num"><Delta value={t.pnl} decimals={0} /></td><td class="num"><Delta value={t.r} decimals={2} suffix=" R" /></td></tr>)}</tbody></table></div>}
<h3 class="t-h2">Voided <span class="src">{L.voids.length}</span></h3>{L.voids.length === 0 ? <p class="gap">No voids so far. That is a fact about {L.picks.length} calls as of {dmy(L.as_of)}, not a promise.</p> : <div class="scroll short"><table class="t-table"><thead><tr><th>Date</th><th>Stock</th><th>Reason</th></tr></thead><tbody>{L.voids.map((v) => <tr><td>{dmy(v.date)}</td><td>{L.picks.find((p) => p.id === v.pick_id)?.symbol}</td><td class="src">{v.reason}</td></tr>)}</tbody></table></div>}
<details class="table-alt"><summary>Passed the rules but not taken ({nt.size}), with the reason for each</summary><div class="scroll short"><table class="t-table"><thead><tr><th>Stock</th><th>Passed</th><th>Reason</th></tr></thead><tbody>{[...nt].map(([sym, e]) => <tr><td><a href={`/stock/${sym}/`}>{sym}</a></td><td class="src">{e.screens.join(', ')}</td><td class="src">{e.why}</td></tr>)}</tbody></table></div></details></div></section>
</div>
<script src="../scripts/tabs.ts"></script></Terminal>
