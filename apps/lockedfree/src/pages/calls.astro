---
import Terminal from '../layouts/Terminal.astro'; import Delta from '../components/Delta.astro'; import EquityCard from '../components/EquityCard.astro'; import StatBlock from '../components/StatBlock.astro'; import Icon from '../components/Icon.astro';
import { SCREENS } from '../lib/screens.ts'; import { METHOD, COMMON } from '../lib/methodology.ts'; import { RATES, CHARGES_VERSION } from '../lib/charges.ts'; import { ruleText } from '../lib/exitrules.ts';  import { TICKET, MAX_OPEN, SECTOR_CAP, CAPITAL } from '../lib/book.ts';
import { ledger, markFn } from '../lib/data.ts'; import { agg, dmy, signed, inr, tradeRows, bookState, closedStats, holdDays, maxDrawdown } from '../lib/view.ts'; import { bookRisk } from '../lib/risk.ts'; import { SMALL_N } from '../lib/ledger.ts'; import { feedAvailable, loadFeed, num } from '../lib/feed.ts'; import { nextSaturday } from '../lib/dates.ts';
const L = ledger(), mark = markFn(), F = feedAvailable() ? loadFeed() : null; const book = bookState(L, mark); const all = agg(L, 'all'); const rows = tradeRows(L, mark); const open = rows.filter((t) => t.status === 'open' || t.status === 'pending'); const next = nextSaturday(L.as_of ?? new Date().toISOString().slice(0, 10));
const px = (x: number | null | undefined) => (x == null ? '—' : x.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })); const name = (id: string) => SCREENS.find((s) => s.id === id)?.name ?? id; const money = (x: number) => '₹' + x.toLocaleString('en-IN', { maximumFractionDigits: 2 }); const sector = (s: string) => F?.bySym.get(s)?.sector ?? 'Unclassified'; const score = (s: string) => (F ? num(F.bySym.get(s), 'comp') : null);
const secCount: Record<string, number> = {}; for (const t of open) secCount[sector(t.symbol)] = (secCount[sector(t.symbol)] ?? 0) + 1;
const lastRuns = SCREENS.map((s) => L.runs.filter((r) => r.screen_id === s.id).pop()); const nt = new Map<string, { why: string; screens: string[] }>(); for (const r of lastRuns) for (const x of r?.skipped ?? []) { const e = nt.get(x.symbol) ?? { why: x.why, screens: [] }; e.screens.push(name(r!.screen_id)); nt.set(x.symbol, e); }
const risk = bookRisk(L, (sym) => sector(sym)); const cs = closedStats(rows);
const ids = [...SCREENS.map((s) => s.id), 'all']; const exposure = book ? Math.round((book.deployed / book.capital) * 100) : 0;
import ReadingGuide from '../components/ReadingGuide.astro';
---
<Terminal title="Calls" description="The paper book: the open calls, the four rules-based screens behind them, and the full public record with every loss and void. Educational and simulated." live charts>
<div class="t-title"><h1>Calls</h1><span class="stamp">as of {dmy(L.as_of)} · the ledger marks at the close · Last and P&amp;L follow delayed live prices · Simulated — not real returns</span></div>
{book && risk && <p class="stamp book-line"><b>{book.open}</b> of {MAX_OPEN} calls open · <b>{exposure}%</b> invested ({money(book.deployed)} of {money(book.capital)}) · cash after charges {money(book.cash)} · charges paid {money(book.charges)} · lost if every stop is hit <b>{money(risk.riskAtStops)}</b> ({risk.riskPct.toFixed(1)}% of the account) · {all?.n_closed ?? 0} closed · the same book as on <a href="/terminal/">Today</a></p>}
<div data-tabs>
<div class="tabbar" role="tablist" aria-label="Calls" hidden><button role="tab" data-tab="open" aria-selected="true">Open calls ({open.length})</button><button role="tab" data-tab="screens" aria-selected="false">The four screens</button><button role="tab" data-tab="record" aria-selected="false">The record</button></div>
<section role="tabpanel" id="tab-open" class="pane"><div class="pane-b flush">
{open.length === 0 ? <div class="sit pad"><div class="big">No open calls.</div><p class="muted">When nothing passes, the book stays in cash. That is a position, and it is recorded as one.</p></div> : <div class="scroll"><table class="t-table" data-table><thead><tr><th data-facet>Stock</th><th data-facet>Screen</th><th data-facet>Sector</th><th>In</th><th class="num">Qty</th><th class="num">Entry ₹</th><th class="num">Last ₹</th><th class="num">Invested ₹</th><th class="num">P&amp;L ₹</th><th class="num">P&amp;L %</th><th class="num">After charges ₹</th><th class="num">Stop ₹</th><th class="num">Target ₹</th><th>Exit by</th><th class="num">Score</th></tr></thead><tbody>{open.map((t) => <tr data-call={t.symbol} data-qty={t.qty ?? ''} data-entry-px={t.entry_px ?? ''} data-close-date={L.as_of}><td><a href={`/stock/${t.symbol}/`} data-vt={`stock-${t.symbol}`}>{t.symbol}</a></td><td>{name(t.screen_id)}</td><td class="src">{sector(t.symbol)}</td><td data-v={t.entry}>{dmy(t.entry)}</td><td class="num">{t.qty?.toLocaleString('en-IN') ?? '—'}</td><td class="num">{px(t.entry_px)}</td><td class="num" data-q={t.symbol}><span data-q-px>{px(t.last)}</span><small class="src" data-q-time>Close {dmy(L.as_of)}</small></td><td class="num">{t.invested == null ? '—' : Math.round(t.invested).toLocaleString('en-IN')}</td><td class="num" data-pl="gross" data-v={t.gross ?? ''}><Delta value={t.gross} decimals={0} /></td><td class="num" data-pl="gpct" data-v={t.gross_pct ?? ''}><Delta value={t.gross_pct} decimals={2} suffix="%" /></td><td class="num" data-pl="net" data-v={t.pnl ?? ''}><Delta value={t.pnl} decimals={0} /></td><td class="num" title={t.rule}>{px(t.stop)}</td><td class="num" title={t.rule}>{px(t.target)}</td><td data-v={t.exit_by}>{dmy(t.exit_by)}</td><td class="num">{score(t.symbol) == null ? '—' : Math.round(score(t.symbol)!)}</td></tr>)}</tbody></table></div>}
<p class="src pad" data-q-age></p>
<p class="src pad">While NSE is open, Last and the three P&amp;L columns move with delayed live prices (a few minutes behind, from Yahoo through our own Worker); when it is shut they show the latest price. The ledger itself still marks at the close and changes only at night, and a name with no live price keeps its ledger figures. P&amp;L is the price change since entry, before charges, so a call whose price has not moved shows nothing. The After charges column takes off the buy-side costs (and the sell-side costs once a call has closed), about 0.12% of the ticket on the way in. Ledger marks are from the close of {dmy(L.as_of)}. The In column shows each call’s actual entry date. At most {MAX_OPEN} calls are open, at most {SECTOR_CAP} per sector, {money(TICKET)} each. By sector: {Object.entries(secCount).sort((a, b) => b[1] - a[1]).map(([k, v]) => `${k} ${v}`).join(' · ') || '—'}.</p>
<details class="table-alt pad"><summary>Exit rules: when each engine sells (never later than one month)</summary><ul>{SCREENS.map((s) => <li><strong>{s.name}:</strong> {ruleText(s.id)}</li>)}</ul><p class="src">If one session touches both the stop and the target, the stop is assumed to have come first. Daily prices cannot show the order inside a day.</p></details></div></section>
<section role="tabpanel" id="tab-screens" class="pane"><div class="pane-b"><ol class="pipe" aria-label="How a pass becomes a call"><li><b>1</b><span>Screen</span><small>four published rule sets run on the daily feed</small></li><li><b>2</b><span>Rank</span><small>at most five listed per screen, by composite score</small></li><li><b>3</b><span>Book rules</span><small>30 open, 4 per sector, no duplicates</small></li><li><b>4</b><span>Size</span><small>₹3.3 L ticket, whole shares</small></li><li><b>5</b><span>Fill</span><small>at the signal-day close</small></li><li><b>6</b><span>Exit</span><small>stop, target, dropped, or one month</small></li></ol><div class="grid g2">{SCREENS.map((s, i) => { const run = lastRuns[i]; const m = METHOD[s.id]; const a = agg(L, s.id); return <article class="card" id={s.id}><div class="card-head"><h2>{s.name}</h2><span class="pill">v{s.version}</span></div><p class="muted">{s.short}</p>
<p class="stamp">{run ? `${run.run_date ? 'Run of ' + dmy(run.run_date) : ''} · universe ${run.universe_n} · ${run.passed.length} pass · ${run.listed?.length ?? run.passed.length} listed · not scorable ${run.not_scorable_n} · next refresh ${dmy(next)}` : 'No run yet'}</p>
{run && run.passed.length === 0 ? <div class="sit"><div class="big">0 stocks pass all rules this week. Cash is a position.</div>{run.near_miss?.length ? <p class="muted">{run.near_miss.length} are one criterion away: {run.near_miss.slice(0, 6).map((n) => `${n.symbol} (${n.failed_rule})`).join('; ')}.</p> : null}</div> : <ul class="chips">{(run?.listed ?? run?.passed ?? []).map((sym) => <li><a class="chip" data-state={open.some((o) => o.symbol === sym && o.screen_id === s.id) ? 'call' : 'skipped'} href={`/stock/${sym}/`}>{sym}<span class="stamp">{open.some((o) => o.symbol === sym && o.screen_id === s.id) ? 'call' : open.some((o) => o.symbol === sym) ? 'also passes' : 'listed'}</span></a></li>)}</ul>}
<details class="table-alt"><summary>The rules and what can go wrong</summary><ol>{m.rules.map((r) => <li>{r}</li>)}</ol><p class="src">Origin: {m.origin}</p><ul>{m.weaknesses.map((w) => <li>{w}</li>)}<li>{COMMON.trail}</li></ul></details>
<p class="row"><a class="btn ghost" href={`/plan/?screen=${s.id}`}><Icon name="plan" size={16} />Follow this screen (paper)</a><span class="pill">n = {a?.n_closed ?? 0} closed</span></p></article>; })}</div>
<p class="src">The screen universe is the dated run’s stocks with market cap of at least ₹2,000 crore; it is smaller than the tracked universe and can change. Lists first ran on 17 November 2026; subsequent runs use Friday’s close and are published on Saturday.</p><details class="table-alt" id="run-history"><summary>Published screen-run history ({L.runs.length} runs)</summary>{[...L.runs].reverse().map((r) => <p class="src"><strong>{name(r.screen_id)} · {dmy(r.run_date)}</strong> · run {r.screen_id}__{r.run_date} · {(r.listed ?? r.passed).join(', ') || 'No listed stocks'}</p>)}</details><details class="table-alt mt4"><summary>How a pass becomes a call, and what the simulation leaves out</summary><p>{COMMON.sources}</p><p>{COMMON.cadence}</p><p>{COMMON.lag}</p><p>{COMMON.book}</p><p>{COMMON.mechanics}</p><p>{COMMON.basis}</p><p>{COMMON.size}</p><p>{COMMON.missing}</p><p class="src">Charges, schedule {CHARGES_VERSION}: delivery equity. STT {RATES.sttPct}% on both sides, exchange {RATES.exchangePct}%, SEBI {RATES.sebiPct}%, stamp duty {RATES.stampBuyPct}% on buys, GST {RATES.gstPct}% on fees, a flat ₹{RATES.dpSellFlat} depository charge on sells. R is measured to each call's own initial stop. Rates are starting values to be checked against the official schedules.</p></details></div></section>
<section role="tabpanel" id="tab-record" class="pane"><div class="pane-b"><EquityCard vt={false} />
<h3 class="t-h2">Scoreboard <span class="src">every figure shows its n · as of {dmy(L.as_of)}</span></h3><div class="scroll"><table class="t-table" data-table><thead><tr><th>Screen</th><th class="num">Calls</th><th class="num">Open</th><th class="num">Closed (n)</th><th class="num">Void</th><th class="num">Win rate</th><th class="num">Expectancy</th><th class="num">Max drawdown</th></tr></thead><tbody>{ids.map((id) => { const a = agg(L, id); return <tr><td><strong>{id === 'all' ? 'All screens' : name(id)}</strong>{a?.honesty && <div class="src" data-warn>{a.honesty}</div>}</td><td class="num">{a?.n_picks ?? 0}</td><td class="num">{a?.n_open ?? 0}</td><td class="num">{a?.n_closed ?? 0}</td><td class="num">{a?.n_void ?? 0}</td><td class="num">{a?.win_rate == null ? '—' : Math.round(a.win_rate * 100) + '%'}</td><td class="num">{a?.expectancy_r == null ? '—' : signed(a.expectancy_r, 2, ' R')}</td><td class="num">{a ? inr(maxDrawdown(L, id)) : '—'}</td></tr>; })}</tbody></table></div>
<p class="src">Win rate and expectancy use closed trades only. 1R is the original risk to that call's own stop (see the exit rules on the Open calls tab). Nothing here can be deleted. Simulated — not real returns.</p>
<h3 class="t-h2">Closed-call statistics <span class="src">n = {cs.n}{cs.n < SMALL_N ? ' — too few to conclude anything' : ''} · after charges</span></h3>{cs.n === 0 ? <p class="gap">No call has closed yet, so there is nothing to measure.</p> : <dl class="kv"><dt>Profit factor (wins ÷ losses)</dt><dd>{cs.profitFactor ?? '—'}</dd><dt>Average win</dt><dd>{cs.avgWin == null ? '—' : inr(cs.avgWin)}</dd><dt>Average loss</dt><dd>{cs.avgLoss == null ? '—' : inr(cs.avgLoss)}</dd><dt>Average time held</dt><dd>{cs.avgHold == null ? '—' : cs.avgHold + ' days'}</dd><dt>Best · worst</dt><dd>{cs.best == null ? '—' : inr(cs.best)} · {cs.worst == null ? '—' : inr(cs.worst)}</dd></dl>}
<h3 class="t-h2">Closed trades <span class="src">n = {rows.filter((t) => t.status === 'closed').length} · every exit, wins and losses alike</span></h3>{rows.filter((t) => t.status === 'closed').length === 0 ? <p class="gap">No call has closed yet. Closed trades, including every loss, are listed here the day they close.</p> : <div class="scroll short"><table class="t-table" data-table><thead><tr><th data-facet>Stock</th><th data-facet>Screen</th><th>In</th><th>Out</th><th class="num">Held (days)</th><th class="num">Qty</th><th class="num">Entry ₹</th><th class="num">Exit ₹</th><th data-facet>Why it closed</th><th class="num">P&amp;L ₹</th><th class="num">P&amp;L %</th><th class="num">After charges ₹</th><th class="num">R</th></tr></thead><tbody>{rows.filter((t) => t.status === 'closed').sort((a, b) => (b.exit ?? '').localeCompare(a.exit ?? '')).slice(0, 150).map((t) => <tr><td><a href={`/stock/${t.symbol}/`}>{t.symbol}</a></td><td>{name(t.screen_id)}</td><td data-v={t.entry}>{dmy(t.entry)}</td><td data-v={t.exit}>{dmy(t.exit)}</td><td class="num">{holdDays(t.entry, t.exit) ?? '—'}</td><td class="num">{t.qty?.toLocaleString('en-IN') ?? '—'}</td><td class="num">{px(t.entry_px)}</td><td class="num">{px(t.exit_px)}</td><td class="src">{t.reason}</td><td class="num" data-v={t.gross ?? ''}><Delta value={t.gross} decimals={0} /></td><td class="num" data-v={t.gross_pct ?? ''}><Delta value={t.gross_pct} decimals={2} suffix="%" /></td><td class="num" data-v={t.pnl ?? ''}><Delta value={t.pnl} decimals={0} /></td><td class="num" data-v={t.r ?? ''}><Delta value={t.r} decimals={2} suffix=" R" /></td></tr>)}</tbody></table></div>}
<h3 class="t-h2">Voided <span class="src">{L.voids.length}</span></h3>{L.voids.length === 0 ? <p class="gap">No voids so far. That is a fact about {L.picks.length} calls as of {dmy(L.as_of)}, not a promise.</p> : <div class="scroll short"><table class="t-table" data-table><thead><tr><th>Date</th><th data-facet>Stock</th><th>Reason</th></tr></thead><tbody>{L.voids.map((v) => <tr><td>{dmy(v.date)}</td><td>{L.picks.find((p) => p.id === v.pick_id)?.symbol}</td><td class="src">{v.reason}</td></tr>)}</tbody></table></div>}
<details class="table-alt"><summary>Passed the rules but not taken ({nt.size}), with the reason for each</summary><div class="scroll short"><table class="t-table" data-table><thead><tr><th data-facet>Stock</th><th data-facet>Passed</th><th>Reason</th></tr></thead><tbody>{[...nt].map(([sym, e]) => <tr><td><a href={`/stock/${sym}/`}>{sym}</a></td><td class="src">{e.screens.join(', ')}</td><td class="src">{e.why}</td></tr>)}</tbody></table></div></details></div></section>
</div>
<ReadingGuide swipe />
<script src="../scripts/tabs.ts"></script></Terminal>
