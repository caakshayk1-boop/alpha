---
import Terminal from '../../layouts/Terminal.astro'; import Icon from '../../components/Icon.astro';
import { loadFeed, cohorts, sectorOf, industryOf, tierOf, f1, cr } from '../../lib/feed.ts'; import { stockModel, PIOTROSKI_LABELS } from '../../lib/stockpage.ts'; import { returnLadder, groupedBars, bars } from '../../lib/svg.ts'; import { dmy } from '../../lib/view.ts'; import RuleList from '../../components/RuleList.astro'; import { runsFor } from '../../lib/feedscreens.ts'; import { SCREENS } from '../../lib/screens.ts'; import { ledger } from '../../lib/data.ts';
export function getStaticPaths() { const F = loadFeed(); return F.rows.map((r) => ({ params: { symbol: r.sym }, props: { sym: r.sym } })); }
const F = loadFeed(); const { sym } = Astro.props; const r = F.bySym.get(sym)!; const m = stockModel(F, cohorts(), r);
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']; const tier = tierOf(r); const ind = industryOf(r);
const pos = m.head.low != null && m.head.high != null && m.head.price.raw != null && m.head.high > m.head.low ? Math.min(100, Math.max(0, ((m.head.price.raw - m.head.low) / (m.head.high - m.head.low)) * 100)) : null;
const trend = m.sections.find((s) => s.id === 'trend')!; const ladder = ['1 week', '1 month', '3 months', '6 months', '1 year'].map((l) => trend.stats.find((s) => s.label === l)!);
const trendKv = trend.stats.filter((x) => !['1 week', '1 month', '3 months', '6 months', '1 year'].includes(x.label));
const years = [...m.fy].reverse(); const fyLabels = years.map((y: any) => y.fy); const keyStats = m.sections.filter((s) => s.id !== 'trend');
const desc = `${r.name} (${sym}): ${m.write.position} ${m.read.facts[0]?.sentence ?? ''}`.replace(/\s+/g, ' ').slice(0, 300);
const sc = (n: number | null) => (n == null ? 0 : Math.max(0, Math.min(100, n)));
const L = ledger(); const call = L.picks.find((p) => p.symbol === sym && (p.status === 'open' || p.status === 'pending')); const sname = (id: string) => SCREENS.find((x) => x.id === id)?.name ?? id;
const results = runsFor(F).map((run) => { const d = run.detail[sym]; const verdict = !d ? 'Outside the screens\' universe' : d.passes ? (run.listed?.includes(sym) ? 'Passes and is listed' : 'Passes, but is outside the screen\'s best five') : !d.scorable ? 'Not scorable: an input is missing' : d.failed.length === 1 ? `One rule away: ${d.failed[0].label}` : `Fails ${d.failed.length} rules`; return { id: run.screen_id, name: sname(run.screen_id), d, verdict, open: !!d && (d.passes || d.failed.length === 1) }; });
---
<Terminal title={`${sym} · ${r.name}`} description={desc} charts live>
<div class="pane reveal-pane" data-q={sym}><div class="pane-b stk-head" data-vt={`stock-${sym}`}>
  <div class="t-title"><div><div class="crumbs"><a href="/screener/">← Screener</a><span>/</span>{r.sector ? <a href={`/screener/?sector=${encodeURIComponent(r.sector)}`}>{sectorOf(r)}</a> : <span>Unclassified</span>}{ind && ind !== sectorOf(r) ? <span>/ {ind}</span> : null}{tier ? <span>/ {tier}-cap</span> : null}</div><h1>{r.name}</h1><span class="stamp">NSE: {sym}{r.isin ? ` · ${r.isin}` : ''}</span></div>
  <button class="star" type="button" data-watch={sym} aria-pressed="false" aria-label={`Watch ${sym}`}><Icon name="star" size={18} /></button></div>
  <div class="stk-px"><span class="p" data-q-px data-v={m.head.price.raw ?? ''}>{m.head.price.value}</span>
  <span class={m.head.r1d.tone} data-q-chg>{m.head.r1d.value}</span><span class="stamp">close {m.head.lastDate ? dmy(m.head.lastDate) : 'date missing'} · day change from the feed until a delayed quote arrives</span></div>
  <div class="stamp stale-line" data-q-age>waiting for first quote…</div>
  {pos != null ? <><div class="range" role="img" aria-label={`52-week range: low ${m.head.low}, high ${m.head.high}`}><i class="rx" data-x={pos.toFixed(1)}></i></div><div class="row stamp"><span>52-week low ₹{f1(m.head.low)}</span><span>{m.head.fromHigh.value} from the high</span><span>52-week high ₹{f1(m.head.high)}</span></div></> : <p class="gap">52-week range is missing in the source data.</p>}
</div></div>

<div class="glance" aria-label="Headline numbers">{m.glance.map((x) => <div class="g"><span class="label">{x.label}</span><span class={`v ${x.tone}`} title={x.raw == null ? 'missing in the source data' : undefined}>{x.value}</span></div>)}</div>
<section class="pane read"><div class="pane-h"><span><span class="idx">●</span>The read</span><span>written from the data</span></div><div class="pane-b">{call && <a class="callbadge" href="/calls/"><Icon name="ledger" size={16} />Open paper call · {sname(call.screen_id)} · since {dmy(call.fills[0]?.date)} · see the book</a>}
  <p class="lead">{m.write.position}</p>
  {m.read.facts.length ? <ul class="facts">{m.read.facts.map((f) => <li><span class={`tag ${f.good === true ? 'pos' : f.good === false ? 'neg' : ''}`}>{f.good === true ? 'Strength' : f.good === false ? 'Weakness' : 'Note'}</span><span>{f.sentence}</span></li>)}{m.read.caution && <li><span class={`tag ${m.read.caution.s === 'high' ? 'neg' : ''}`}>Watch</span><span>{m.read.caution.t}</span></li>}</ul> : <p class="gap">Nothing about this stock is unusual against its sector peers. The tabs below hold the full picture.</p>}
  <div class="scores">{m.scores.map((x) => <div class="sc"><span class="l">{x.label}</span><div class="meter"><b data-w={sc(x.raw)}></b></div><span class="n">{x.value}</span></div>)}</div></div></section>
<section class="pane"><div class="pane-b"><div class="chart-bar"><div class="seg" role="group" aria-label="Candle interval"><button type="button" data-ivl="D" aria-pressed="true">Daily</button><button type="button" data-ivl="W" aria-pressed="false">Weekly</button><button type="button" data-ivl="M" aria-pressed="false">Monthly</button></div><button type="button" class="seg-btn" data-fit>Full history</button><span class="chip-trend" data-trend></span></div><p class="stamp" data-chart-legend aria-live="off"></p>
  <div class="chart tall" data-price-chart={sym} data-hi={m.head.high ?? ''} data-lo={m.head.low ?? ''} role="img" aria-label={`Candlestick chart of ${sym}, full history, with volume`}></div><p class="src" data-chart-note>delayed daily closes, loads on demand</p></div></section>
<div data-tabs>
<div class="tabbar" role="tablist" aria-label="Details" hidden><button role="tab" data-tab="profile" aria-selected="true">Profile</button><button role="tab" data-tab="financials" aria-selected="false">Financials</button><button role="tab" data-tab="stats" aria-selected="false">All numbers</button><button role="tab" data-tab="trend" aria-selected="false">Trend</button><button role="tab" data-tab="screens" aria-selected="false">Screens</button><button role="tab" data-tab="peers" aria-selected="false">Peers</button></div>
<section role="tabpanel" id="tab-profile" class="pane"><div class="pane-b prose-t"><h2 class="t-h">Profile</h2><p>{m.write.profile}</p><p>{m.write.trend}</p>{m.business && <p class="small muted" data-quoted><span class="src">Company description, as given in the source feed: </span>{m.business}</p>}
  {m.moreFacts.length > 0 && <><h3 class="t-h2">More against peers</h3><ul class="facts">{m.moreFacts.map((f) => <li><span class={`tag ${f.good === true ? 'pos' : f.good === false ? 'neg' : ''}`}>{f.good === true ? 'Strength' : f.good === false ? 'Weakness' : 'Note'}</span><span>{f.sentence}</span></li>)}</ul></>}
  {m.moreCautions.length > 0 && <><h3 class="t-h2">More cautions in the data</h3><ul class="facts">{m.moreCautions.map((c) => <li><span class={`tag ${c.s === 'high' ? 'neg' : ''}`}>{c.s}</span><span>{c.t}</span></li>)}</ul></>}
  {m.allocation.length > 0 && <><h3 class="t-h2">How it has used its cash</h3><ul class="facts">{m.allocation.map((a) => <li><span class={`tag ${a.good ? 'pos' : 'neg'}`}>{a.good ? 'Good' : 'Poor'}</span><span>{a.t}</span></li>)}</ul></>}</div></section>
<section role="tabpanel" id="tab-financials" class="pane"><div class="pane-b"><h2 class="t-h">Financials <span class="src">₹ crore, fiscal years to March</span></h2>{years.length ? <><Fragment set:html={groupedBars([{ name: 'Revenue', vals: years.map((y: any) => y.rev_cr ?? null), cls: 'bar' }, { name: 'Profit after tax', vals: years.map((y: any) => y.pat_cr ?? null), cls: 'bar2' }], fyLabels, `Revenue and profit after tax of ${sym} by fiscal year`)} />
  <details class="table-alt"><summary>Full numbers</summary><div class="scroll short"><table class="t-table"><thead><tr><th>Line</th>{years.map((y: any) => <th class="num">{y.fy}</th>)}</tr></thead><tbody>{[['rev_cr', 'Revenue'], ['ebitda_cr', 'EBITDA'], ['pat_cr', 'Profit after tax'], ['eps', 'EPS ₹'], ['cfo_cr', 'Operating cash flow'], ['fcf_cr', 'Free cash flow'], ['dividends_cr', 'Dividends paid'], ['buyback_cr', 'Buybacks']].map(([k, l]) => <tr><td>{l}</td>{years.map((y: any) => <td class:list={['num', y[k] == null && 'gap']}>{y[k] == null ? '—' : Math.abs(y[k]).toLocaleString('en-IN', { maximumFractionDigits: k === 'eps' ? 2 : 0 })}{y[k] != null && y[k] < 0 && (k === 'dividends_cr' || k === 'buyback_cr') ? ' paid' : ''}</td>)}</tr>)}</tbody></table></div></details></> : <p class="gap">No annual statements are in the source data for this stock.</p>}
  {m.valhist?.history?.length ? <><h3 class="t-h2">P/E against its own history</h3><Fragment set:html={bars(([...m.valhist.history].reverse()).map((h: any) => h.pe ?? null), ([...m.valhist.history].reverse()).map((h: any) => h.fy), `P/E of ${sym} by fiscal year`, 360, 130, (v) => v.toFixed(1) + '×')} /><p class="src">Own median {f1(m.valhist.median ?? null)}×, range {f1(m.valhist.low ?? null)}–{f1(m.valhist.high ?? null)}×.</p></> : null}</div></section>
<section role="tabpanel" id="tab-stats" class="pane"><div class="pane-b"><h2 class="t-h">All numbers <span class="src">the headline six are above</span></h2><div class="grid-stats">{keyStats.map((x) => <div><h3 class="t-h2">{x.title}</h3><dl class="kv">{x.stats.map((y) => <><dt>{y.label}</dt><dd class={y.tone} class:list={[y.raw == null && 'gap']} title={y.raw == null ? 'missing in the source data' : undefined}>{y.value}</dd></>)}</dl></div>)}
  <div><h3 class="t-h2">Quality checks <span class="src">{m.checks.n ?? '—'} of {m.checks.total ?? 9}</span></h3>{m.checks.bits ? <div class="pbits">{PIOTROSKI_LABELS.map((l, i) => <div><span class={m.checks.bits![i] === '1' ? 'up' : 'down'}><Icon name={m.checks.bits![i] === '1' ? 'check' : 'x'} size={16} label={m.checks.bits![i] === '1' ? 'Pass' : 'Fail'} /></span><span>{l}</span></div>)}</div> : <p class="gap">The nine-test breakdown is missing in the source data.</p>}</div></div></div></section>
<section role="tabpanel" id="tab-trend" class="pane"><div class="pane-b"><h2 class="t-h">Trend</h2><div class="grid-stats"><div><h3 class="t-h2">Returns</h3><Fragment set:html={returnLadder(ladder.map((x, i) => ({ label: ['1 week', '1 month', '3 months', '6 months', '1 year'][i], v: x.raw })), `Returns of ${sym} over five horizons`)} /></div><div><h3 class="t-h2">Momentum and risk</h3><dl class="kv">{trendKv.map((y) => <><dt>{y.label}</dt><dd class={y.tone} class:list={[y.raw == null && 'gap']}>{y.value}</dd></>)}</dl></div>
  <div><h3 class="t-h2">Calendar months <span class="src">{m.season ? `${m.season.y} years` : 'not covered'}</span></h3>{m.season ? <><p class="src">Share of years it rose in that month, and the median move.</p><div class="months">{m.season.m.map((c: any, i: number) => <div data-month={i + 1} class:list={[c && c[2] >= 8 && c[0] >= 70 && 'hi', c && c[2] >= 8 && c[0] <= 30 && 'lo']}>{MON[i]}<b>{c && c[2] >= 8 ? `${c[0]}%` : '—'}</b>{c && c[2] >= 8 ? `${c[1] > 0 ? '+' : c[1] < 0 ? '−' : ''}${Math.abs(c[1]).toFixed(1)}%` : 'n<8'}</div>)}</div><p class="src mt4">This records what repeatedly happened. It is not a forecast, and a month needs 8 observations to be shown.</p></> : <p class="gap">Seasonality is not available for this stock.</p>}</div></div></div></section>
<section role="tabpanel" id="tab-screens" class="pane"><div class="pane-b"><h2 class="t-h">Where it stands against the four screens <span class="src">rule by rule, as of the latest run</span></h2>{results.map((x) => <details class="table-alt scr" open={x.open}><summary><strong>{x.name}</strong> <span class={`pill ${x.d?.passes ? 'pass' : ''}`}>{x.verdict}</span></summary>{x.d ? <RuleList rules={x.d.rules} /> : <p class="gap">Only stocks with a market cap of at least ₹2,000 crore are screened.</p>}</details>)}<p class="src">Each rule shows the figure it used. A tick passes, a cross fails, and a question mark means an input was missing (never guessed). Passing is not a recommendation. <a href="/calls/#screens">How the screens and the book work</a>.</p></div></section>
<section role="tabpanel" id="tab-peers" class="pane"><div class="pane-b flush"><h2 class="t-h pad">Closest peers <span class="src">same sector, nearest on the four scores and size</span></h2>{m.peers.length ? <div class="scroll short"><table class="t-table"><thead><tr><th>Stock</th><th class="num">Quality</th><th class="num">Growth</th><th class="num">Value</th><th class="num">Trend</th><th class="num">ROCE</th><th class="num">P/E</th><th class="num">3M</th></tr></thead><tbody>{m.peers.map((p) => <tr><td><a href={`/stock/${p.sym}/`}>{p.sym}</a> <span class="src">{p.name}</span></td>{[['q', 0], ['g', 0], ['v', 0], ['tech', 0], ['roce', 1], ['pe', 1], ['r3m', 1]].map(([k, d]) => <td class="num">{typeof p[k as string] === 'number' ? p[k as string].toLocaleString('en-IN', { maximumFractionDigits: d as number, minimumFractionDigits: d as number }) : '—'}</td>)}</tr>)}</tbody></table></div> : <p class="pad gap">No comparable peers: scores or sector are missing for this stock.</p>}</div></section>
</div>
<p class="src">Source: daily feed, prices as of {dmy(F.asOf)}, built {dmy(F.builtOn)}. {m.gaps.length ? `Not in the source data for ${sym}: ${m.gaps.join(', ')}. These are shown as missing, not estimated.` : 'Every field used on this page is present.'} Educational information, not advice. Nothing here is a recommendation to buy, sell or hold. Simulated figures are not real returns.</p>
<script src="../../scripts/tabs.ts"></script><script src="../../scripts/stock.ts"></script><script src="../../scripts/watch.ts"></script></Terminal>
