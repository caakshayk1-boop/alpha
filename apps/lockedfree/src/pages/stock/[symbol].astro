---
import Terminal from '../../layouts/Terminal.astro'; import Icon from '../../components/Icon.astro';
import { loadFeed, cohorts, sectorOf, industryOf, tierOf, f1, cr } from '../../lib/feed.ts'; import { stockModel, PIOTROSKI_LABELS } from '../../lib/stockpage.ts'; import { divergingBars, bars } from '../../lib/svg.ts'; import { dmy } from '../../lib/view.ts';
export function getStaticPaths() { const F = loadFeed(); return F.rows.map((r) => ({ params: { symbol: r.sym }, props: { sym: r.sym } })); }
const F = loadFeed(); const { sym } = Astro.props; const r = F.bySym.get(sym)!; const m = stockModel(F, cohorts(), r);
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']; const tier = tierOf(r); const ind = industryOf(r);
const pos = m.head.low != null && m.head.high != null && m.head.price.raw != null && m.head.high > m.head.low ? Math.min(100, Math.max(0, ((m.head.price.raw - m.head.low) / (m.head.high - m.head.low)) * 100)) : null;
const trend = m.sections.find((s) => s.id === 'trend')!; const ladder = ['1 week', '1 month', '3 months', '6 months', '1 year'].map((l) => trend.stats.find((s) => s.label === l)!);
const years = [...m.fy].reverse(); const fyLabels = years.map((y: any) => y.fy); const keyStats = m.sections.filter((s) => s.id !== 'trend');
const desc = `${r.name} (${sym}): ${m.write.position} ${m.facts[0]?.sentence ?? ''}`.replace(/\s+/g, ' ').slice(0, 300);
const sc = (n: number | null) => (n == null ? 0 : Math.max(0, Math.min(100, n)));
---
<Terminal title={`${sym} · ${r.name}`} description={desc} charts live>
<div class="pane reveal-pane" data-q={sym}><div class="pane-b stk-head" data-vt={`stock-${sym}`}>
  <div class="t-title"><div><div class="crumbs"><a href="/screener/">← Screener</a><span>/</span>{r.sector ? <a href={`/screener/?sector=${encodeURIComponent(r.sector)}`}>{sectorOf(r)}</a> : <span>Unclassified</span>}{ind && ind !== sectorOf(r) ? <span>/ {ind}</span> : null}{tier ? <span>/ {tier}-cap</span> : null}</div><h1>{r.name}</h1><span class="stamp">NSE: {sym}{r.isin ? ` · ${r.isin}` : ''}</span></div>
  <button class="star" type="button" data-watch={sym} aria-pressed="false" aria-label={`Watch ${sym}`}><Icon name="star" size={18} /></button></div>
  <div class="stk-px"><span class="p" data-q-px data-v={m.head.price.raw ?? ''}>{m.head.price.value}</span>
  <span class={m.head.r1d.tone} data-q-chg>{m.head.r1d.value}</span><span class="stamp">close {m.head.lastDate ? dmy(m.head.lastDate) : 'date missing'} · day change from the feed until a delayed quote arrives</span></div>
  <div class="stamp stale-line" data-q-age>waiting for first quote…</div>
  {pos != null ? <><div class="range" role="img" aria-label={`52-week range: low ${m.head.low}, high ${m.head.high}`}><i class="rx" data-x={pos.toFixed(1)}></i></div><div class="row stamp"><span>52-week low ₹{f1(m.head.low)}</span><span>{m.head.fromHigh.value} from the high</span><span>52-week high ₹{f1(m.head.high)}</span></div></> : <p class="gap">52-week range is missing in the source data.</p>}
</div></div>
<div class="panes">
<section class="pane span-8"><div class="pane-h"><span><span class="idx">01</span>Profile</span><span>Written from the data</span></div><div class="pane-b prose-t"><p class="lead">{m.write.position}</p><p>{m.write.profile}</p><p>{m.write.trend}</p>{m.business && <p class="small muted" data-quoted><span class="src">Company description, as given in the source feed: </span>{m.business}</p>}</div></section>
<section class="pane span-4"><div class="pane-h"><span><span class="idx">02</span>Scores, 0–100</span><span>vs all 999</span></div><div class="pane-b">{m.scores.map((s) => <div class="score"><span class="l">{s.label}</span><div class="meter"><b data-w={sc(s.raw)}></b></div><span class="n">{s.value}</span></div>)}
<p class="src">Scores are the source feed's own, built from the measures shown here. A missing score is left empty.</p></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">03</span>What stands out against peers</span><span>rank, not value</span></div><div class="pane-b">{m.facts.length ? <ul class="facts">{m.facts.map((f) => <li><span class={`tag ${f.good === true ? 'pos' : f.good === false ? 'neg' : ''}`}>{f.good === true ? 'Strength' : f.good === false ? 'Weakness' : 'Note'}</span><span>{f.sentence}</span></li>)}</ul> : <p class="gap">Nothing about this stock is unusual against its sector peers. The figures below are the whole picture.</p>}</div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">04</span>Cautions in the data</span><span>{m.cautions.length} flagged</span></div><div class="pane-b">{m.cautions.length ? <ul class="facts">{m.cautions.map((c) => <li><span class={`tag ${c.s === 'high' ? 'neg' : ''}`}>{c.s}</span><span>{c.t}</span></li>)}</ul> : <p class="gap">The source raises no data cautions for this stock.</p>}
{m.allocation.length > 0 && <><h4 class="mt4">How it has used its cash</h4><ul class="facts">{m.allocation.map((a) => <li><span class={`tag ${a.good ? 'pos' : 'neg'}`}>{a.good ? 'Good' : 'Poor'}</span><span>{a.t}</span></li>)}</ul></>}</div></section>
{keyStats.map((s, i) => <section class="pane span-4"><div class="pane-h"><span><span class="idx">{String(5 + i).padStart(2, '0')}</span>{s.title}</span></div><div class="pane-b"><dl class="kv">{s.stats.map((x) => <><dt>{x.label}</dt><dd class={x.tone} class:list={[x.raw == null && 'gap']} title={x.raw == null ? 'missing in the source data' : undefined}>{x.value}</dd></>)}</dl></div></section>)}
<section class="pane span-8"><div class="pane-h"><span><span class="idx">10</span>Trend</span><span>returns, then momentum</span></div><div class="pane-b"><Fragment set:html={divergingBars(ladder.map((s) => s.raw), ['1W', '1M', '3M', '6M', '1Y'], `Returns of ${sym} over five horizons`)} /><dl class="kv mt4">{trend.stats.map((x) => <><dt>{x.label}</dt><dd class={x.tone} class:list={[x.raw == null && 'gap']}>{x.value}</dd></>)}</dl></div></section>
<section class="pane span-4"><div class="pane-h"><span><span class="idx">11</span>Quality checks</span><span>{m.checks.n ?? '—'} of {m.checks.total ?? 9}</span></div><div class="pane-b">{m.checks.bits ? <div class="pbits">{PIOTROSKI_LABELS.map((l, i) => <div><span class={m.checks.bits![i] === '1' ? 'up' : 'down'}><Icon name={m.checks.bits![i] === '1' ? 'check' : 'x'} size={16} label={m.checks.bits![i] === '1' ? 'Pass' : 'Fail'} /></span><span>{l}</span></div>)}</div> : <p class="gap">The nine-test breakdown is missing in the source data.</p>}</div></section>
<section class="pane span-12"><div class="pane-h"><span><span class="idx">12</span>Financial history</span><span>₹ crore, fiscal years to March</span></div><div class="pane-b">{years.length ? <div class="grid-stats"><div><Fragment set:html={bars(years.map((y: any) => y.rev_cr ?? null), fyLabels, `Revenue of ${sym} by fiscal year`)} /><p class="src">Revenue</p></div><div><Fragment set:html={bars(years.map((y: any) => y.pat_cr ?? null), fyLabels, `Profit after tax of ${sym} by fiscal year`)} /><p class="src">Profit after tax</p></div></div> : null}
{years.length ? <div class="scroll short"><table class="t-table"><thead><tr><th>Line</th>{years.map((y: any) => <th class="num">{y.fy}</th>)}</tr></thead><tbody>{[['rev_cr', 'Revenue'], ['ebitda_cr', 'EBITDA'], ['pat_cr', 'Profit after tax'], ['eps', 'EPS ₹'], ['cfo_cr', 'Operating cash flow'], ['fcf_cr', 'Free cash flow'], ['dividends_cr', 'Dividends paid'], ['buyback_cr', 'Buybacks']].map(([k, l]) => <tr><td>{l}</td>{years.map((y: any) => <td class:list={['num', y[k] == null && 'gap']}>{y[k] == null ? '—' : Math.abs(y[k]).toLocaleString('en-IN', { maximumFractionDigits: k === 'eps' ? 2 : 0 })}{y[k] != null && y[k] < 0 && (k === 'dividends_cr' || k === 'buyback_cr') ? ' paid' : ''}</td>)}</tr>)}</tbody></table></div> : <p class="gap">No annual statements are in the source data for this stock.</p>}</div></section>
<section class="pane span-8"><div class="pane-h"><span><span class="idx">13</span>Price, one year</span><span data-chart-note>delayed, loads on demand</span></div><div class="pane-b"><div class="chart" data-price-chart={sym} role="img" aria-label={`One-year closing price of ${sym}`}></div></div></section>
<section class="pane span-4"><div class="pane-h"><span><span class="idx">14</span>Calendar months</span><span>{m.season ? `${m.season.y} years` : 'not covered'}</span></div><div class="pane-b">{m.season ? <><p class="src">Share of years the stock rose in that month, and the median move.</p><div class="months">{m.season.m.map((c: any, i: number) => <div data-month={i + 1} class:list={[c && c[2] >= 8 && c[0] >= 70 && 'hi', c && c[2] >= 8 && c[0] <= 30 && 'lo']}>{MON[i]}<b>{c && c[2] >= 8 ? `${c[0]}%` : '—'}</b>{c && c[2] >= 8 ? `${c[1] > 0 ? '+' : c[1] < 0 ? '−' : ''}${Math.abs(c[1]).toFixed(1)}%` : 'n<8'}</div>)}</div><p class="src mt4">This records what repeatedly happened. It is not a forecast, and a month needs 8 observations to be shown.</p></> : <p class="gap">Seasonality is not available for this stock.</p>}
{m.valhist?.history?.length ? <><h4 class="mt4">P/E against its own history</h4><Fragment set:html={bars(([...m.valhist.history].reverse()).map((h: any) => h.pe ?? null), ([...m.valhist.history].reverse()).map((h: any) => h.fy), `P/E of ${sym} by fiscal year`, 300, 110)} /><p class="src">Own median {f1(m.valhist.median ?? null)}×, range {f1(m.valhist.low ?? null)}–{f1(m.valhist.high ?? null)}×.</p></> : null}</div></section>
<section class="pane span-12"><div class="pane-h"><span><span class="idx">15</span>Closest peers</span><span>same sector, nearest on the four scores and size</span></div><div class="pane-b flush">{m.peers.length ? <div class="scroll short"><table class="t-table"><thead><tr><th>Stock</th><th class="num">Quality</th><th class="num">Growth</th><th class="num">Value</th><th class="num">Trend</th><th class="num">ROCE</th><th class="num">P/E</th><th class="num">3M</th></tr></thead><tbody>{m.peers.map((p) => <tr><td><a href={`/stock/${p.sym}/`}>{p.sym}</a> <span class="src">{p.name}</span></td>{[['q', 0], ['g', 0], ['v', 0], ['tech', 0], ['roce', 1], ['pe', 1], ['r3m', 1]].map(([k, d]) => <td class="num">{typeof p[k as string] === 'number' ? p[k as string].toLocaleString('en-IN', { maximumFractionDigits: d as number, minimumFractionDigits: d as number }) : '—'}</td>)}</tr>)}</tbody></table></div> : <p class="pane-b gap">No comparable peers: scores or sector are missing for this stock.</p>}</div></section>
<section class="pane span-12"><div class="pane-b"><p class="src">Source: daily feed, prices as of {dmy(F.asOf)}, built {dmy(F.builtOn)}. {m.gaps.length ? `Not in the source data for ${sym}: ${m.gaps.join(', ')}. These are shown as missing, not estimated.` : 'Every field used on this page is present.'} Educational information, not advice. Nothing here is a recommendation to buy, sell or hold. Simulated figures are not real returns.</p></div></section>
</div>
<script src="../../scripts/stock.ts"></script><script src="../../scripts/watch.ts"></script></Terminal>
