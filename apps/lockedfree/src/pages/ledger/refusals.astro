---
import Base from '../../layouts/Base.astro'; import { ledger } from '../../lib/data.ts'; import { dmy } from '../../lib/view.ts'; import { SCREENS } from '../../lib/screens.ts';
const L = ledger(); const last = SCREENS.map((sc) => L.runs.filter((r) => r.screen_id === sc.id).pop()).filter(Boolean); const nt = new Map<string, { why: string; screens: string[]; date: string }>(); for (const r of last) for (const x of r!.skipped ?? []) { const e = nt.get(x.symbol) ?? { why: x.why, screens: [], date: r!.run_date }; e.screens.push(SCREENS.find((sc) => sc.id === r!.screen_id)!.name); nt.set(x.symbol, e); }
---
<Base title="Refusals" description="Stocks the screens rejected, and what they did afterwards: the filter's counterfactual record.">
<div class="wrap hero"><span class="label eyebrow">The Ledger</span><h1>What the filters turned away</h1><p class="lede">A screen is only useful if the stocks it turns away do worse than the ones it keeps. This page records the near misses, the names one rule away from passing, with their price at the time. Names far from passing are not tracked, so the list stays readable.</p></div>
<div class="wrap">{L.refusals.length === 0 ? <div class="sit"><div class="big">No refusals recorded yet.</div><p class="muted">Refused names are tracked from the first weekly run. Names that could not be scored are listed separately, because "could not be scored" is not the same as "refused".</p></div> :
<table class="cards"><thead><tr><th>Refused on</th><th>Stock</th><th>Screen</th><th class="num">Price then</th></tr></thead><tbody>{L.refusals.slice(-500).reverse().map((x) => <tr><td data-label="Refused on">{dmy(x.refused_on)}</td><td data-label="Stock">{x.symbol}</td><td data-label="Screen">{SCREENS.find((s) => s.id === x.screen_id)?.name}</td><td class="num" data-label="Price then">{x.price_at_refusal ?? 'missing'}</td></tr>)}</tbody></table>}
<p class="stamp">as of {dmy(L.as_of)}. Later price paths are added as they happen; none is back-filled.</p></div><div class="wrap"><h2 data-u="sec">Passed the rules, not taken</h2><p class="muted">These stocks passed a screen but the book did not take them as calls: it holds at most 30, at most 4 in a sector, and never the same name twice. Each reason is recorded.</p>
{nt.size === 0 ? <div class="sit"><div class="big">Every passer was taken.</div></div> : <table class="cards"><thead><tr><th>Stock</th><th>Passed</th><th>Reason</th></tr></thead><tbody>{[...nt].map(([sym, e]) => <tr><td data-label="Stock"><a href={`/stock/${sym}/`}>{sym}</a></td><td data-label="Passed">{e.screens.join(', ')}</td><td data-label="Reason">{e.why}</td></tr>)}</tbody></table>}<p class="stamp">as of {dmy(L.as_of)}</p></div></Base>
