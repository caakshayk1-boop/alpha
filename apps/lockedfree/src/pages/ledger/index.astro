---
import Base from '../../layouts/Base.astro'; import StatBlock from '../../components/StatBlock.astro'; import EquityCard from '../../components/EquityCard.astro'; import Delta from '../../components/Delta.astro';
import { SCREENS } from '../../lib/screens.ts'; import { ledger, markFn } from '../../lib/data.ts'; import { agg, dmy, signed, inr, tradeRows, bookState } from '../../lib/view.ts'; import { feedAvailable, loadFeed } from '../../lib/feed.ts';
const L = ledger(); const rows = tradeRows(L, markFn()).sort((a, b) => (b.entry ?? '').localeCompare(a.entry ?? '')); const all = agg(L, 'all');
const ids = [...SCREENS.map((s) => s.id), 'all']; const book = bookState(L, markFn()); const F = feedAvailable() ? loadFeed() : null;
const secCount: Record<string, number> = {}; if (F) for (const p of L.picks) if (p.status === 'open') { const sec = F.bySym.get(p.symbol)?.sector ?? 'Unclassified'; secCount[sec] = (secCount[sec] ?? 0) + 1; }
const money = (x: number) => '₹' + x.toLocaleString('en-IN');
---
<Base title="The Ledger" charts description="The complete public record: every pick, paper trade and voided item, with expectancy, drawdown and sample size beside any return.">
<div class="wrap hero"><span class="label eyebrow">The Ledger</span><h1>Everything, in one place, with nothing removed.</h1><p class="lede">Every pick, every paper trade, every void. Each number states how many trades it rests on and the date it was made. Nothing here can be deleted.</p></div>
<div class="wrap"><EquityCard />
{book && <><h2 data-u="sec">The book</h2><p class="stamp">as of {dmy(L.as_of)} · rules from Tripwire's paper book · Simulated — not real returns</p>
<div class="grid g4 card"><div class="stat"><span class="label">Account</span><span class="v">{money(book.capital)}</span><span class="n">paper balance</span></div><div class="stat"><span class="label">Open calls</span><span class="v">{book.open} <small>of {book.maxOpen}</small></span><span class="n">n = {book.open}</span></div><div class="stat"><span class="label">Deployed</span><span class="v">{money(book.deployed)}</span><span class="n">ticket {money(book.ticket)} each</span></div><div class="stat"><span class="label">Cash left</span><span class="v">{money(book.cash)}</span><span class="n">after buy charges of {money(book.charges)}</span></div></div>
{Object.keys(secCount).length > 0 && <p class="small muted" data-u="mt3">By sector (at most {book.sectorCap} each): {Object.entries(secCount).sort((a, b) => b[1] - a[1]).map(([k, v]) => `${k} ${v}`).join(' · ')}.</p>}
<p><a href="/ledger/refusals/">Passed but not taken, with reasons →</a> · <a href="/methodology/">How the book chooses</a></p></>}
<h2 data-u="sec">Scoreboard</h2><p class="stamp">as of {dmy(L.as_of)} · Simulated — not real returns</p>
<table class="cards"><thead><tr><th>Screen</th><th class="num">Picks</th><th class="num">Open</th><th class="num">Closed (n)</th><th class="num">Void</th><th class="num">Win rate</th><th class="num">Expectancy</th><th class="num">Avg win</th><th class="num">Avg loss</th><th class="num">Max drawdown</th><th class="num">Losing streak</th></tr></thead>
<tbody>{ids.map((id) => { const a = agg(L, id); const name = id === 'all' ? 'All screens' : SCREENS.find((s) => s.id === id)!.name; return <tr><td data-label="Screen"><strong>{name}</strong>{a?.honesty && <div class="small" data-u="warnink">{a.honesty}</div>}</td><td class="num" data-label="Picks">{a?.n_picks ?? 0}</td><td class="num" data-label="Open">{a?.n_open ?? 0}</td><td class="num" data-label="Closed (n)">{a?.n_closed ?? 0}</td><td class="num" data-label="Void">{a?.n_void ?? 0}</td><td class="num" data-label="Win rate">{a?.win_rate == null ? '—' : Math.round(a.win_rate * 100) + '%'}</td><td class="num" data-label="Expectancy">{a?.expectancy_r == null ? '—' : signed(a.expectancy_r, 2, ' R')}</td><td class="num" data-label="Avg win">{inr(a?.avg_win)}</td><td class="num" data-label="Avg loss">{inr(a?.avg_loss)}</td><td class="num" data-label="Max drawdown">{a ? inr(a.max_drawdown) : '—'}</td><td class="num" data-label="Losing streak">{a?.longest_losing_streak ?? 0}</td></tr>; })}</tbody></table>
<p class="small muted">Win rate and expectancy are measured on closed trades only. Expectancy is the average result in R, where 1R is the original risk to a 20% stop. Drawdown is the largest fall of the paper profit and loss from its previous high, in rupees.</p>
<h2 data-u="sec">Every pick</h2>
{rows.length === 0 ? <div class="sit"><div class="big">No picks yet.</div><p class="muted">The record begins with the first weekly run. Voided and losing trades will be listed here beside the winners.</p></div> :
<table class="cards"><thead><tr><th>Stock</th><th>Screen</th><th>Status</th><th>In</th><th>Out</th><th class="num">P&amp;L</th><th class="num">R</th></tr></thead><tbody>{rows.map((t) => <tr><td data-label="Stock">{t.symbol}</td><td data-label="Screen">{SCREENS.find((s) => s.id === t.screen_id)?.name}</td><td data-label="Status">{t.reason}</td><td data-label="In">{dmy(t.entry)}</td><td data-label="Out">{t.exit ? dmy(t.exit) : '—'}</td><td class="num" data-label="P&L"><Delta value={t.pnl} decimals={0} /></td><td class="num" data-label="R"><Delta value={t.r} decimals={2} suffix=" R" /></td></tr>)}</tbody></table>}
<p><a class="btn ghost" href="/ledger/voids/">Voided picks</a> <a class="btn ghost" href="/ledger/refusals/">Refusals</a> <a class="btn ghost" href="/methodology/">Accounting method</a></p></div></Base>
