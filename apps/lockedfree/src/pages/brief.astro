---
import Terminal from '../layouts/Terminal.astro'; import { loadFeed, spct, f1 } from '../lib/feed.ts'; import { brief } from '../lib/brief.ts'; import { dmy } from '../lib/view.ts';
const F = loadFeed(), B = brief(F);
---
<Terminal title="Daily brief" description={`Daily brief for ${dmy(F.asOf)}: ${B.headline}. Written by rule from the day's data. Educational; not advice.`} live={false}>
<div class="t-title"><h1>Daily brief</h1><span class="stamp">{dmy(B.asOf)} session · built {dmy(B.builtOn)}</span></div>
<div class="panes"><section class="pane span-8"><div class="pane-h"><span><span class="idx">01</span>{dmy(B.asOf)}</span><span>written by rule, no model</span></div><div class="pane-b prose-t"><p class="lead">{B.headline}</p>{B.paragraphs.map((p) => <p>{p}</p>)}</div></section>
<section class="pane span-4"><div class="pane-h"><span><span class="idx">02</span>Counts</span></div><div class="pane-b">{B.counts.map((c) => <div class="score"><span class="l">{c.label}</span><div class="meter"><b data-w={c.of ? (c.value / c.of) * 100 : 0}></b></div><span class="n">{c.value}</span></div>)}</div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">03</span>Largest rises on heavy volume</span><span>liquid names, volume ≥1.5× usual</span></div><div class="pane-b flush"><table class="t-table"><tbody>{B.unusual.up.map((r) => <tr><td><a href={`/stock/${r.sym}/`}>{r.sym}</a> <span class="src">{r.name}</span></td><td class="num up">{spct(r.r1d, 2)}</td></tr>)}</tbody></table></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">04</span>Largest falls on heavy volume</span><span>liquid names, volume ≥1.5× usual</span></div><div class="pane-b flush"><table class="t-table"><tbody>{B.unusual.down.map((r) => <tr><td><a href={`/stock/${r.sym}/`}>{r.sym}</a> <span class="src">{r.name}</span></td><td class="num down">{spct(r.r1d, 2)}</td></tr>)}</tbody></table></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">05</span>Score rises</span><span>vs {B.compared ? dmy(B.compared) : 'last build'}</span></div><div class="pane-b flush"><table class="t-table"><tbody>{B.scoreRise.map((r) => <tr><td><a href={`/stock/${r.sym}/`}>{r.sym}</a></td><td class="num up">+{f1(r.delta.comp)}</td></tr>)}</tbody></table></div></section>
<section class="pane span-6"><div class="pane-h"><span><span class="idx">06</span>Score falls</span><span>vs {B.compared ? dmy(B.compared) : 'last build'}</span></div><div class="pane-b flush"><table class="t-table"><tbody>{B.scoreFall.map((r) => <tr><td><a href={`/stock/${r.sym}/`}>{r.sym}</a></td><td class="num down">−{f1(Math.abs(r.delta.comp))}</td></tr>)}</tbody></table></div></section></div>
<p class="src">Every figure is read from the day's feed when the site is built; none is typed in. Moves are listed because they happened, not because they are suggestions. Educational information, not advice.</p></Terminal>
