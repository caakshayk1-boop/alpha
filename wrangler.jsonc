{
  "name": "alpha",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Only the data proxy, quotes and the old /company/?s= address (a 301 to /company/<SYM>/) need the Worker; everything else is a static file.
    "run_worker_first": ["/data/*", "/api/*", "/c/*", "/company/"],
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "alpha.askakshay.com", "custom_domain": true }],
  "workers_dev": true,
  // Per-address limit for /api/explain, enforced by Cloudflare (the in-memory limiter in the Worker is only the fallback).
  // Keyed in worker/index.js by IPv4 address or IPv6 /64. Counts are per Cloudflare location and approximate, so the real
  // cap on spend is still the monthly limit on the Anthropic workspace that holds the key.
  "ratelimits": [{ "name": "EXPLAIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // One atomic counter for the explainer's daily budget across every isolate and location (A13). SQLite-backed, free plan.
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "Quota" }] },
  "migrations": [{ "tag": "v1-quota", "new_sqlite_classes": ["Quota"] }],
  "observability": { "enabled": true }
}
